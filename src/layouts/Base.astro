---
import '../styles/global.css';
import Sprite from '../components/ui/Sprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobilLeiste from '../components/MobilLeiste.astro';
import { INDEXIEREN, SITE } from '../lib/config';

interface Props {
  title: string;
  description: string;
  pfad?: string;
  ld?: object[];
  mobilLeiste?: boolean;
  autoReveal?: boolean;
  noindex?: boolean;
  bildAlt?: string;
}
const { title, description, pfad = Astro.url.pathname, ld = [], mobilLeiste = true, autoReveal = true, noindex = false, bildAlt = 'Sushi Auswahl bei Yumini Japanese Sushi & Grill' } = Astro.props;
const url = new URL(pfad, SITE).href;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030504" />
    {INDEXIEREN && !noindex ? <meta name="robots" content="index, follow, max-image-preview:large" /> : <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yumini Japanese Sushi & Grill" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${SITE}/images/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={bildAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/images/og.jpg`} />
    <meta name="twitter:image:alt" content={bildAlt} />
    <meta name="format-detection" content="telephone=yes" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <Sprite />
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {mobilLeiste && <MobilLeiste />}
    {autoReveal && <script>
      // Einblenden beim Scrollen: markiert die Bausteine der Seiten und blendet sie ein, sobald sie ins Bild kommen.
      const auswahl = [
        'main section .head > *', 'main section .kopf > *', 'main section .copy > *', 'main section .intro > *',
        'main section .inner > *', 'main section > .row > *', 'main section .stamp', 'main section .txt > *',
        '.steps > li', '.tiles > li', '.favs > li', '.cards > li', '.mosaik > li', '.bilder > li', '.locs > li', '.grid-in > *',
        '.list > li', '.list > details', '.act', '.notes > *', '.tablist', '.device', '.turn', '.visual', '.map', '.mock', '.marquee',
        '.preise-grid > *', '.facts > li', '.treffer > *', '.zusatz > *',
      ].join(',');
      const alle = Array.from(document.querySelectorAll<HTMLElement>(auswahl)).filter((el) => !el.closest('.no-reveal') && !el.closest('.marquee .track'));
      for (const el of alle) {
        const geschwister = el.parentElement ? Array.from(el.parentElement.children).filter((c) => c.matches(auswahl)) : [];
        const i = Math.max(0, geschwister.indexOf(el));
        el.dataset.reveal = el.matches('.turn, .device, .visual, .map, .mock') ? 'zoom' : '';
        el.style.setProperty('--d', `${Math.min(i, 7) * 0.08}s`);
      }
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((eintraege) => {
          for (const e of eintraege) {
            const el = e.target as HTMLElement;
            if (e.isIntersecting || e.boundingClientRect.top < 0) {
              el.classList.add('is-in');
              io.unobserve(el);
            }
          }
        }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 });
        alle.forEach((el) => io.observe(el));
      } else {
        alle.forEach((el) => el.classList.add('is-in'));
      }
    </script>}
  </body>
</html>
