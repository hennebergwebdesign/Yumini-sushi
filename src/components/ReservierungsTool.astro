---
import { standorte } from '../lib/standorte';

// Interaktive Vorschau: Kalender, Personen, Uhrzeiten und Bestätigung funktionieren im Browser.
// Verfügbarkeit ist simuliert, es wird nichts gespeichert und keine Mail versendet (Bauphase 5).
interface Props { ort?: string }
const { ort = 'bochum' } = Astro.props;
// eindeutige Kennung, falls das Tool mehrfach auf einer Seite steht
const uid = `res-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="tool" data-res data-ort={ort}>
  <div class="status" aria-hidden="true">
    <span data-clock>19:42</span>
    <span class="icons">
      <svg viewBox="0 0 24 16"><path d="M2 12a14 14 0 0 1 20 0M5.5 9a9 9 0 0 1 13 0M9 6a4 4 0 0 1 6 0" /><circle cx="12" cy="13" r="1.3" /></svg>
      <svg viewBox="0 0 30 16"><rect x="1" y="2" width="24" height="12" rx="3" /><rect x="3" y="4" width="17" height="8" rx="1.5" class="fill" /><rect x="26" y="6" width="3" height="4" rx="1" class="fill" /></svg>
    </span>
  </div>

  <div class="app">
    <form class="body" novalidate onsubmit="return false">
      <div class="col">
        <section class="block" aria-labelledby="t-ort">
          <h4 id="t-ort"><span class="n">1</span>Standort</h4>
          <div class="seg" role="radiogroup" aria-labelledby="t-ort">
            {standorte.map((s) => (
              <label>
                <input type="radio" name="t-ort" value={s.id} checked={s.id === ort} />
                <span>{s.name}</span>
              </label>
            ))}
          </div>
          <!-- Mobil: dieselbe Auswahl als Auswahlfeld, kompakter als die Knöpfe -->
          <div class="selwrap">
            <select class="ortsel" data-ortsel aria-labelledby="t-ort">
              {standorte.map((s) => <option value={s.id} selected={s.id === ort}>{s.name}</option>)}
            </select>
          </div>
        </section>

        <section class="block" aria-labelledby="t-datum">
          <h4 id="t-datum"><span class="n">2</span>Datum</h4>
          <!-- Mobil: Datum eintippen, der Kalender klappt über das Symbol auf -->
          <div class="dfeld">
            <input data-dinput type="text" inputmode="numeric" autocomplete="off" maxlength="10" placeholder="TT.MM.JJJJ" aria-labelledby="t-datum" aria-describedby={`${uid}-dinfo`} />
            <button type="button" class="dtoggle" data-dtoggle aria-expanded="false" aria-controls={`${uid}-cal`} aria-label="Kalender öffnen">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
            </button>
          </div>
          <p class="info dinfo" id={`${uid}-dinfo`} data-dinfo aria-live="polite"></p>
          <div class="cal" id={`${uid}-cal`}>
            <div class="calhead">
              <button type="button" data-prev aria-label="Vorheriger Monat">‹</button>
              <strong data-monat>November 2026</strong>
              <button type="button" data-next aria-label="Nächster Monat">›</button>
            </div>
            <div class="grid" data-grid role="group" aria-label="Tage"></div>
          </div>
        </section>
      </div>

      <div class="col">
        <section class="block" aria-labelledby="t-pers">
          <h4 id="t-pers"><span class="n">3</span>Personen</h4>
          <div class="step">
            <button type="button" data-minus aria-label="Eine Person weniger">−</button>
            <output data-pers aria-live="polite">2</output>
            <button type="button" data-plus aria-label="Eine Person mehr">+</button>
            <span class="unit" data-pers-label>Personen</span>
          </div>
          <p class="more" data-mehr hidden>Für Gruppen über 15 Personen bitte eine <a href="/feiern/">Feier anfragen</a>.</p>
        </section>

        <section class="block" aria-labelledby="t-zeit">
          <h4 id="t-zeit"><span class="n">4</span>Uhrzeit</h4>
          <div class="dd" data-dd>
            <button type="button" class="ddbtn" data-ddbtn aria-haspopup="listbox" aria-expanded="false" aria-labelledby="t-zeit"><span data-ddlabel>Bitte Datum wählen</span></button>
            <ul class="ddlist" role="listbox" aria-labelledby="t-zeit" data-ddlist hidden></ul>
          </div>
          <p class="info" data-info></p>
        </section>

        <section class="block" aria-labelledby="t-kontakt">
          <h4 id="t-kontakt"><span class="n">5</span>Ihre Angaben</h4>
          <div class="fields">
            <label><span>Name</span><input data-name type="text" autocomplete="off" placeholder="Vor- und Nachname" /></label>
            <label><span>Telefon</span><input data-tel type="tel" autocomplete="off" placeholder="Für Rückfragen" /></label>
          </div>
        </section>

        <div class="foot">
          <p class="sum" data-sum aria-live="polite"></p>
          <button type="button" class="go" data-go>Tisch reservieren</button>
          <p class="err" data-err role="alert" hidden></p>
        </div>
      </div>
    </form>

    <div class="done" data-done hidden role="status">
      <span class="check" aria-hidden="true">✓</span>
      <h3>Tisch reserviert</h3>
      <p data-done-text></p>
      <p class="muted small" data-live-note>Ihre Reservierungsnummer: <b data-code></b>. Eine Bestätigung per Mail ist noch nicht eingerichtet, bitte notieren Sie sich die Nummer.</p>
      <p class="muted small" data-demo hidden>Beispiel: Es wurde nichts gespeichert und keine Mail versendet.</p>
      <button type="button" class="again" data-again>Neue Reservierung</button>
    </div>
  </div>

  <span class="bar" aria-hidden="true"></span>
</div>

<script>
  import { standorte } from '../lib/standorte';
  import { geoeffnet, slots, preisFuer, iso, type Slot } from '../lib/zeiten';

  const MONATE = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
  const WTAGE = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'];
  const MAXTAGE = 90;

  document.querySelectorAll<HTMLElement>('[data-res]').forEach((root) => {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const grid = $('[data-grid]');
    const dd = $('[data-dd]');
    const ddBtn = $<HTMLButtonElement>('[data-ddbtn]');
    const ddLabel = $('[data-ddlabel]');
    const ddList = $('[data-ddlist]');
    const ddZu = () => {
      ddList.hidden = true;
      ddBtn.setAttribute('aria-expanded', 'false');
    };
    const ddAuf = () => {
      ddList.hidden = false;
      ddBtn.setAttribute('aria-expanded', 'true');
      const ziel = ddList.querySelector<HTMLElement>('[aria-selected="true"]') ?? ddList.querySelector<HTMLElement>('[data-opt]:not([aria-disabled="true"])');
      ziel?.focus();
      ziel?.scrollIntoView({ block: 'nearest' });
    };
    const heute = new Date();
    heute.setHours(0, 0, 0, 0);
    const ende = new Date(heute);
    ende.setDate(ende.getDate() + MAXTAGE);

    const st = {
      ort: root.dataset.ort || 'bochum',
      datum: null as Date | null,
      monat: new Date(heute.getFullYear(), heute.getMonth(), 1),
      pers: 2,
      zeit: '',
      live: true, // echte Verfügbarkeit aus dem Backend, sonst simuliert
      konfig: null as null | { offen: boolean[]; gesperrt: string[]; maxOnline: number },
      zeiten: [] as Slot[],
      folge: 0,
    };
    const standort = () => standorte.find((s) => s.id === st.ort)!;

    const clock = () => {
      const n = new Date();
      $('[data-clock]').textContent = `${String(n.getHours()).padStart(2, '0')}:${String(n.getMinutes()).padStart(2, '0')}`;
    };
    clock();
    setInterval(clock, 30000);

    const offen = (d: Date) => (st.konfig ? st.konfig.offen[d.getDay()] && !st.konfig.gesperrt.includes(iso(d)) : geoeffnet(standort(), d));
    const hole = async (pfad: string) => {
      const r = await fetch(pfad, { headers: { Accept: 'application/json' } });
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    };
    async function ladeKonfig() {
      try {
        st.konfig = await hole(`/api/reservierung/konfig/?ort=${st.ort}`);
        st.live = true;
        // "Heute" gilt in Berlin, auch wenn das Gerät eine andere Zeitzone hat
        const [y, m, t] = (st.konfig as any).heute.split('-').map(Number);
        heute.setFullYear(y, m - 1, t);
        ende.setTime(heute.getTime());
        ende.setDate(ende.getDate() + MAXTAGE);
      } catch {
        st.konfig = null;
        st.live = false;
      }
      $('[data-demo]').hidden = st.live;
      $('[data-live-note]').hidden = !st.live;
    }
    async function ladeZeiten() {
      const d = st.datum;
      const n = ++st.folge;
      if (!d || st.pers > 15) {
        st.zeiten = [];
        return;
      }
      let z: Slot[];
      if (st.live) {
        try {
          z = (await hole(`/api/reservierung/zeiten/?ort=${st.ort}&datum=${iso(d)}&personen=${st.pers}`)).zeiten;
        } catch {
          st.live = false;
          $('[data-demo]').hidden = false;
          $('[data-live-note]').hidden = true;
          z = slots(standort(), d, st.pers);
        }
      } else z = slots(standort(), d, st.pers);
      if (n === st.folge) st.zeiten = z;
    }

    const dInput = $<HTMLInputElement>('[data-dinput]');
    const dToggle = $<HTMLButtonElement>('[data-dtoggle]');
    const dInfo = $('[data-dinfo]');
    const ortSel = $<HTMLSelectElement>('[data-ortsel]');
    const zwei = (n: number) => String(n).padStart(2, '0');
    const fmt = (d: Date) => `${zwei(d.getDate())}.${zwei(d.getMonth() + 1)}.${d.getFullYear()}`;
    const kalender = (auf: boolean) => {
      root.classList.toggle('cal-auf', auf);
      dToggle.setAttribute('aria-expanded', String(auf));
      dToggle.setAttribute('aria-label', auf ? 'Kalender schließen' : 'Kalender öffnen');
    };
    // Eingabe TT.MM.JJJJ, auch TT.MM.JJ oder nur Ziffern (241026, 24102026)
    const lies = (v: string) => {
      const t = v.trim();
      const m = t.match(/^(\d{1,2})[./\- ](\d{1,2})[./\- ](\d{2}|\d{4})$/) ?? t.match(/^(\d{2})(\d{2})(\d{2}|\d{4})$/);
      if (!m) return null;
      const [tag, mon] = [Number(m[1]), Number(m[2])];
      const jahr = m[3].length === 2 ? 2000 + Number(m[3]) : Number(m[3]);
      const d = new Date(jahr, mon - 1, tag);
      return d.getMonth() === mon - 1 && d.getDate() === tag ? d : null;
    };
    const uebernehme = () => {
      if (!dInput.value.trim()) return;
      const d = lies(dInput.value);
      let meldung = '';
      if (!d) meldung = 'Bitte das Datum als TT.MM.JJJJ eingeben.';
      else if (d < heute) meldung = 'Dieses Datum liegt in der Vergangenheit.';
      else if (d > ende) meldung = `Reservierungen sind bis ${fmt(ende)} möglich.`;
      else if (!offen(d)) meldung = `${standort().name} hat an diesem Tag geschlossen.`;
      dInfo.textContent = meldung;
      dInput.setAttribute('aria-invalid', String(!!meldung));
      if (meldung || !d) return;
      st.datum = d;
      st.monat = new Date(d.getFullYear(), d.getMonth(), 1);
      dInput.value = fmt(d);
      alles();
    };
    dInput.addEventListener('input', (e) => {
      // Punkte setzt das Feld selbst, auf dem Ziffernblock des Handys gibt es oft keinen
      if ((e as InputEvent).inputType?.startsWith('delete')) return;
      const z = dInput.value.replace(/\D/g, '').slice(0, 8);
      dInput.value = z.length > 4 ? `${z.slice(0, 2)}.${z.slice(2, 4)}.${z.slice(4)}` : z.length > 2 ? `${z.slice(0, 2)}.${z.slice(2)}` : z;
      if (z.length === 8) uebernehme();
    });
    dInput.addEventListener('change', uebernehme);
    dInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); uebernehme(); }
    });

    const naechsterOffenerTag = () => {
      const d = new Date(heute);
      for (let i = 0; i < 14; i++) {
        if (offen(d) && (st.live || slots(standort(), d, st.pers).some((x) => x.frei))) return d;
        d.setDate(d.getDate() + 1);
      }
      return new Date(heute);
    };

    function renderKalender() {
      const m = st.monat;
      $('[data-monat]').textContent = `${MONATE[m.getMonth()]} ${m.getFullYear()}`;
      const erster = new Date(m.getFullYear(), m.getMonth(), 1);
      const versatz = (erster.getDay() + 6) % 7;
      const tage = new Date(m.getFullYear(), m.getMonth() + 1, 0).getDate();
      const head = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'].map((t) => `<span class="dow" aria-hidden="true">${t}</span>`).join('');
      let html = head + '<span></span>'.repeat(versatz);
      for (let i = 1; i <= tage; i++) {
        const d = new Date(m.getFullYear(), m.getMonth(), i);
        const aus = d < heute || d > ende || !offen(d);
        const gewaehlt = st.datum && iso(d) === iso(st.datum);
        const label = `${WTAGE[(d.getDay() + 6) % 7]}, ${i}. ${MONATE[d.getMonth()]}${aus ? ', nicht möglich' : ''}`;
        html += `<button type="button" class="day${gewaehlt ? ' on' : ''}${iso(d) === iso(heute) ? ' today' : ''}" data-d="${iso(d)}" ${aus ? 'disabled' : ''} aria-label="${label}" aria-pressed="${!!gewaehlt}">${i}</button>`;
      }
      grid.innerHTML = html;
      ($('[data-prev]') as HTMLButtonElement).disabled = m <= new Date(heute.getFullYear(), heute.getMonth(), 1);
      ($('[data-next]') as HTMLButtonElement).disabled = new Date(m.getFullYear(), m.getMonth() + 1, 1) > ende;
    }

    function renderZeiten() {
      const d = st.datum;
      const info = $('[data-info]');
      ddZu();
      const leer = (text: string, meldung = '') => {
        ddList.innerHTML = '';
        ddLabel.textContent = text;
        ddBtn.disabled = true;
        info.textContent = meldung;
        st.zeit = '';
      };
      if (!d || st.pers > 15) return leer('Bitte Datum wählen');
      const alle = st.zeiten;
      if (!alle.length) return leer('Geschlossen', `${standort().name} hat an diesem Tag geschlossen.`);
      let html = '';
      for (const g of ['Mittag', 'Abend'] as const) {
        const teil = alle.filter((x) => x.gruppe === g);
        if (!teil.length) continue;
        html += `<li class="grp" role="presentation">${g}</li>` + teil.map((x) => `<li role="option" tabindex="-1" data-opt data-t="${x.t}" aria-selected="false" ${x.frei ? '' : 'aria-disabled="true"'}>${x.t} Uhr${x.frei ? '' : ' (ausgebucht)'}</li>`).join('');
      }
      ddList.innerHTML = html;
      const frei = alle.filter((x) => x.frei);
      if (!frei.some((x) => x.t === st.zeit)) st.zeit = frei[0]?.t ?? '';
      ddList.querySelector(`[data-t="${st.zeit}"]`)?.setAttribute('aria-selected', 'true');
      ddBtn.disabled = !frei.length;
      ddLabel.textContent = st.zeit ? `${st.zeit} Uhr` : 'Nichts mehr frei';
      info.textContent = frei.length ? '' : 'An diesem Tag ist leider nichts mehr frei. Bitte anderes Datum wählen.';
    }

    function renderSumme() {
      const sum = $('[data-sum]');
      const d = st.datum;
      if (!d || !st.zeit) {
        sum.textContent = 'Bitte Datum und Uhrzeit wählen.';
        return;
      }
      const gruppe = Number(st.zeit.slice(0, 2)) < 16 ? 'Mittag' : 'Abend';
      const preis = preisFuer(standort(), d, gruppe);
      sum.innerHTML = `<b>${standort().name}</b>, ${WTAGE[(d.getDay() + 6) % 7]} ${d.getDate()}. ${MONATE[d.getMonth()]}, ${st.zeit} Uhr, ${st.pers} ${st.pers === 1 ? 'Person' : 'Personen'}${preis ? `<br /><span class="muted">All you can eat ${preis} je Person, ${standort().dauer} Zeit am Tisch</span>` : ''}`;
    }

    function renderPersonen() {
      $('[data-pers]').textContent = String(st.pers);
      $('[data-pers-label]').textContent = st.pers === 1 ? 'Person' : 'Personen';
      ($('[data-minus]') as HTMLButtonElement).disabled = st.pers <= 1;
      ($('[data-plus]') as HTMLButtonElement).disabled = st.pers >= 16;
      $('[data-pers]').textContent = st.pers > 15 ? '15+' : String(st.pers);
      $('[data-mehr]').hidden = st.pers <= 15;
      ($('[data-go]') as HTMLButtonElement).disabled = st.pers > 15;
    }

    async function alles() {
      if (document.activeElement !== dInput) {
        dInput.value = st.datum ? fmt(st.datum) : '';
        dInfo.textContent = '';
        dInput.removeAttribute('aria-invalid');
      }
      renderKalender();
      renderPersonen();
      await ladeZeiten();
      renderZeiten();
      renderSumme();
    }

    const start = async () => {
      await ladeKonfig();
      st.datum = naechsterOffenerTag();
      st.monat = new Date(st.datum.getFullYear(), st.datum.getMonth(), 1);
      await alles();
    };

    root.addEventListener('change', async (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 't-ort' || t === (ortSel as unknown as HTMLInputElement)) {
        st.ort = t.value;
        ortSel.value = t.value;
        root.querySelectorAll<HTMLInputElement>('input[name="t-ort"]').forEach((r) => (r.checked = r.value === t.value));
        await ladeKonfig();
        if (!st.datum || !offen(st.datum)) st.datum = naechsterOffenerTag();
        st.monat = new Date(st.datum.getFullYear(), st.datum.getMonth(), 1);
        alles();
      }
    });

    const waehle = (li: HTMLElement) => {
      if (li.getAttribute('aria-disabled') === 'true') return;
      st.zeit = li.dataset.t!;
      renderZeiten();
      renderSumme();
      ddBtn.focus();
    };
    ddBtn.addEventListener('click', () => (ddList.hidden ? ddAuf() : ddZu()));
    ddBtn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        ddAuf();
      }
    });
    ddList.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[data-opt]');
      if (li) waehle(li);
    });
    ddList.addEventListener('keydown', (e) => {
      const opts = [...ddList.querySelectorAll<HTMLElement>('[data-opt]:not([aria-disabled="true"])')];
      const i = opts.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'ArrowDown') opts[Math.min(opts.length - 1, i + 1)]?.focus();
      else if (e.key === 'ArrowUp') opts[Math.max(0, i - 1)]?.focus();
      else if (e.key === 'Home') opts[0]?.focus();
      else if (e.key === 'End') opts[opts.length - 1]?.focus();
      else if (e.key === 'Enter' || e.key === ' ') {
        if (i >= 0) waehle(opts[i]);
      } else if (e.key === 'Escape' || e.key === 'Tab') {
        if (e.key === 'Escape') ddBtn.focus();
        ddZu();
        return;
      } else return;
      e.preventDefault();
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) ddZu();
    });

    root.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.dataset.d) {
        const [y, mo, da] = b.dataset.d.split('-').map(Number);
        st.datum = new Date(y, mo - 1, da);
        kalender(false);
        alles();
      } else if (b.hasAttribute('data-dtoggle')) {
        kalender(!root.classList.contains('cal-auf'));
      } else if (b.hasAttribute('data-prev')) {
        st.monat = new Date(st.monat.getFullYear(), st.monat.getMonth() - 1, 1);
        renderKalender();
      } else if (b.hasAttribute('data-next')) {
        st.monat = new Date(st.monat.getFullYear(), st.monat.getMonth() + 1, 1);
        renderKalender();
      } else if (b.hasAttribute('data-minus')) {
        st.pers = Math.max(1, st.pers - 1);
        alles();
      } else if (b.hasAttribute('data-plus')) {
        st.pers = Math.min(16, st.pers + 1);
        alles();
      } else if (b.hasAttribute('data-go')) {
        const err = $('[data-err]');
        const name = ($('[data-name]') as HTMLInputElement).value.trim();
        const tel = ($('[data-tel]') as HTMLInputElement).value.trim();
        const fehler = !st.datum || !st.zeit ? 'Bitte Datum und Uhrzeit wählen.' : name.length < 2 ? 'Bitte geben Sie Ihren Namen ein.' : tel.replace(/\D/g, '').length < 6 ? 'Bitte geben Sie eine Telefonnummer ein.' : '';
        err.hidden = !fehler;
        err.textContent = fehler;
        if (fehler) return;
        const go = b as HTMLButtonElement;
        if (st.live) {
          go.disabled = true;
          try {
            const r = await fetch('/api/reservierung/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ort: st.ort, datum: iso(st.datum!), zeit: st.zeit, personen: st.pers, name, telefon: tel, website: '' }),
            });
            const d = await r.json().catch(() => ({}));
            if (!r.ok) {
              err.hidden = false;
              err.textContent = d.fehler ?? 'Die Reservierung ist gerade nicht möglich. Bitte rufen Sie uns an.';
              if (r.status === 409) await alles(); // Zeiten neu laden, die Uhrzeit war inzwischen vergeben
              go.disabled = false;
              return;
            }
            $('[data-code]').textContent = d.code;
          } catch {
            err.hidden = false;
            err.textContent = 'Keine Verbindung. Bitte versuchen Sie es erneut oder rufen Sie uns an.';
            go.disabled = false;
            return;
          }
          go.disabled = false;
        }
        $('[data-done-text]').textContent = `${name}, wir erwarten Sie am ${WTAGE[(st.datum!.getDay() + 6) % 7]}, ${st.datum!.getDate()}. ${MONATE[st.datum!.getMonth()]} um ${st.zeit} Uhr in ${standort().name}, ${st.pers} ${st.pers === 1 ? 'Person' : 'Personen'}.`;
        $('[data-done]').hidden = false;
        root.classList.add('is-done');
      } else if (b.hasAttribute('data-again')) {
        $('[data-done]').hidden = true;
        root.classList.remove('is-done');
        ($('[data-name]') as HTMLInputElement).value = '';
        ($('[data-tel]') as HTMLInputElement).value = '';
      }
    });

    start();
  });
</script>

<style>
  .tool {
