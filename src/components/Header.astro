---
import Logo from './ui/Logo.astro';
import { standorte } from '../lib/standorte';

const nav = [
  { href: '/speisekarte/', label: 'Speisekarte' },
  { href: '/#standorte', label: 'Standorte', sub: true },
  { href: '/#preise', label: 'Preise' },
  { href: '/#feiern', label: 'Feiern' },
  { href: '/karriere/', label: 'Karriere' },
];
---
<header class="bar" data-kopf>
  <a class="brand" href="/" aria-label="Yumini, zur Startseite"><Logo hoehe={64} /></a>

  <div class="pill">
    <a class="home" href="/" aria-label="Startseite">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 11 12 3.8l8.5 7.2" /><path d="M5.8 9.8V20h4.4v-5.4h3.6V20h4.4V9.8" /></svg>
    </a>
    <nav class="desk" aria-label="Hauptnavigation">
      <ul>
        {nav.map((n) => (
          <li class={n.sub ? 'has-sub' : undefined}>
            <a href={n.href}>{n.label}{n.sub && <svg class="chev" viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" /></svg>}</a>
            {n.sub && (
              <ul class="sub">
                {standorte.map((o) => <li><a href={`/${o.id}/`}><b>{o.name}</b><small>{o.strasse}</small></a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a class="res" href="/#reservieren">Tisch reservieren</a>

    <button type="button" class="burger" data-oc-auf aria-label="Menü öffnen" aria-haspopup="dialog" aria-expanded="false" aria-controls="offcanvas"><span></span><span></span></button>
  </div>

  <!-- Mobiles Menü als Off Canvas über die ganze Seite. showModal legt es in die oberste Ebene, Fokus bleibt darin, Esc schließt. -->
  <dialog id="offcanvas" class="oc" data-oc aria-label="Menü">
    <div class="ochead">
      <a class="ocbrand" href="/" aria-label="Yumini, zur Startseite"><Logo hoehe={56} /></a>
      <button type="button" class="occlose" data-oc-zu aria-label="Menü schließen">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <nav class="ocnav" aria-label="Mobile Navigation">
      <ul>
        <li><a href="/">Startseite</a></li>
        {nav.map((n) => (
          <li>
            {n.sub ? (
              <details class="ocsub">
                <summary>{n.label}<svg class="occhev" viewBox="0 0 12 12" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" /></svg></summary>
                <ul>
                  {standorte.map((o) => <li><a href={`/${o.id}/`}><b>{o.name}</b><small>{o.strasse}</small></a></li>)}
                  <li><a href={n.href}><b>Alle Standorte im Überblick</b></a></li>
                </ul>
              </details>
            ) : (
              <a href={n.href}>{n.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a class="occta" href="/#reservieren">Tisch reservieren</a>
  </dialog>
</header>

<style>
  .bar {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: clamp(0.6rem, 1.6svh, 1rem) var(--gutter) 0;
    pointer-events: none;
    animation: kopf-ein 0.9s var(--ease) 0.1s backwards;
  }
  @keyframes kopf-ein {
    from { opacity: 0; translate: 0 -1.25rem; }
  }
  .bar .brand :global(img) {
    block-size: clamp(2.75rem, 3.2vw + 1.4rem, 4rem);
    inline-size: auto;
  }
  .brand {
    pointer-events: auto;
    justify-self: start;
    display: inline-flex;
    text-decoration: none;
    filter: drop-shadow(0 0 1.5px rgb(0 0 0 / 0.85)) drop-shadow(0 2px 8px rgb(0 0 0 / 0.55));
  }
  .pill {
    pointer-events: auto;
    position: fixed;
    inset-block-start: clamp(0.6rem, 1.6svh, 1rem);
    inset-inline: 0;
    inline-size: max-content;
    margin-inline: auto;
    z-index: 50;
    transition: translate 0.35s var(--ease), opacity 0.25s var(--ease);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.3rem 0.3rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(3 5 4 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  /* Beim Runterscrollen ausgeblendet, beim Hochscrollen wieder da */
  :global(html.kopf-weg) .pill {
    translate: 0 calc(-100% - 1.5rem);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill { transition: opacity 0.01s; }
  }
  .desk > ul {
    display: flex;
    gap: 0.1rem;
  }
  .home {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    color: var(--text-muted);
    transition: color 0.2s, background-color 0.2s, transform 0.3s var(--ease);
  }
  .home:hover { color: var(--text); background: rgb(255 255 255 / 0.09); transform: translateY(-1px); }
  .chev { display: inline-block; margin-inline-start: 0.35rem; vertical-align: 0.05em; transition: rotate 0.25s var(--ease); }
  .has-sub { position: relative; }
  .has-sub:hover .chev, .has-sub:focus-within .chev { rotate: 180deg; }
  .sub {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 50%;
    translate: -50% 0.4rem;
    inline-size: 17rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r4);
    background: rgb(3 5 4 / 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease), translate 0.25s var(--ease), visibility 0s linear 0.25s;
  }
  /* unsichtbare Brücke, damit der Mauszeiger beim Wechsel zur Auswahl nichts schließt */
  .sub::before { content: ''; position: absolute; inset: -0.6rem 0 auto 0; block-size: 0.6rem; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; translate: -50% 0; transition-delay: 0s; }
  .desk .sub a { display: grid; gap: 0.05rem; padding: 0.6rem 0.85rem; border-radius: var(--r2); }
  .desk .sub b { font-weight: 500; color: var(--text); }
  .desk .sub small { font-size: 0.78rem; }
  .desk .sub a:hover { background: rgb(255 255 255 / 0.09); }
  .desk a {
    display: block;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: clamp(0.84rem, 0.6rem + 0.35vw, 0.9375rem);
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s, background-color 0.2s;
  }
  .desk a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.09);
  }
  .res {
    display: grid;
    place-items: center;
    min-block-size: 2.5rem;
    padding-inline: 1.1rem;
    margin-inline-start: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: clamp(0.84rem, 0.6rem + 0.35vw, 0.9375rem);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .res:hover {
    border-color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .burger {
    display: none;
    place-items: center;
    align-content: center;
    gap: 5px;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: none;
    cursor: pointer;
  }
  .burger span {
    display: block;
    inline-size: 1.1rem;
    block-size: 2px;
    background: var(--text);
  }

  /* Off Canvas: deckt die ganze Seite ab, kommt von rechts */
  .oc {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: clamp(0.6rem, 1.6svh, 1rem) var(--gutter) max(1.25rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--black);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: auto; /* die Kopfzeile selbst lässt Klicks durch, das Menü nicht */
  }
  .oc[open] {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 4svh, 2.5rem);
    animation: oc-ein 0.4s var(--ease);
  }
  .oc.zu { animation: oc-aus 0.25s var(--ease) forwards; }
  .oc::backdrop { background: rgb(3 5 4 / 0.6); }
  @keyframes oc-ein { from { translate: 100% 0; } }
  @keyframes oc-aus { to { translate: 100% 0; } }
  :global(html:has(.oc[open])) { overflow: hidden; }
  .ochead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ocbrand { display: inline-flex; }
  .ocbrand :global(img) {
    block-size: clamp(2.75rem, 3.2vw + 1.4rem, 4rem);
    inline-size: auto;
  }
  .occlose {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .occlose:hover { border-color: var(--text); }
  .ocnav > ul > li { border-block-end: 1px solid var(--border); }
  .ocnav > ul > li > a,
  .ocsub summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(0.8rem, 2.2svh, 1.1rem);
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 5.5vw, 1.75rem);
    line-height: 1.1;
    text-decoration: none;
    color: var(--text);
    cursor: pointer;
  }
  .ocsub summary { list-style: none; }
  .ocsub summary::-webkit-details-marker { display: none; }
  .occhev { flex: none; transition: rotate 0.25s var(--ease); }
  .ocsub[open] .occhev { rotate: 180deg; }
  .ocsub ul {
    display: grid;
    gap: 0.1rem;
    padding-block-end: 0.9rem;
  }
  .ocsub a {
    display: grid;
    gap: 0.05rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--r2);
    text-decoration: none;
  }
  .ocsub a:hover { background: rgb(255 255 255 / 0.08); }
  .ocsub b { font-weight: 500; font-size: 1.0625rem; }
  .ocsub small { font-size: 0.85rem; color: var(--text-muted); }
  .ocnav a:focus-visible,
  .ocsub summary:focus-visible { outline: 3px solid var(--coral-soft); outline-offset: 2px; }
  .occta {
    display: grid;
    place-items: center;
    margin-block-start: auto;
    min-block-size: 3.5rem;
    border-radius: var(--r2);
    background: var(--brand-red);
    color: #fff;
    font-weight: 500;
    font-size: 1.125rem;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .occta:hover { background: var(--red-deep); }
  @media (prefers-reduced-motion: reduce) {
    .oc[open], .oc.zu { animation: none; }
  }

  @media (max-width: 68rem) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .desk,
    .home,
    .res {
      display: none;
    }
    .burger {
      display: grid;
    }
    .pill {
      padding: 0.3rem;
      inset-inline: auto var(--gutter);
      margin-inline: 0;
    }
  }
</style>

<script>
  // Hide on Scroll: nach unten weg, nach oben (oder ganz oben) wieder da. Offenes Menü und Tastaturfokus halten sie sichtbar.
  const root = document.documentElement;
  const pille = document.querySelector<HTMLElement>('[data-kopf] .pill');
  const menue = document.querySelector<HTMLDialogElement>('[data-oc]');
  const oeffner = document.querySelector<HTMLButtonElement>('[data-oc-auf]');
  let letzte = window.scrollY;
  let wartet = false;
  const pruefen = () => {
    wartet = false;
    const y = Math.max(0, window.scrollY);
    const delta = y - letzte;
    const gehalten = !!pille && (pille.matches(':focus-within') || !!menue?.open);
    if (y < 80 || delta < -6 || gehalten) root.classList.remove('kopf-weg');
    else if (delta > 6) root.classList.add('kopf-weg');
    if (Math.abs(delta) > 6) letzte = y;
  };
  window.addEventListener('scroll', () => { if (!wartet) { wartet = true; requestAnimationFrame(pruefen); } }, { passive: true });
  // Sprungmarken (#reservieren) scrollen nach unten: Pille bleibt dann weg, bis man hochscrollt
  pille?.addEventListener('focusin', () => root.classList.remove('kopf-weg'));

  // Off Canvas öffnen und schließen. Schließen läuft animiert, Links schließen sofort, damit Sprungmarken scrollen können.
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');
  const zu = () => {
    if (!menue?.open || menue.classList.contains('zu')) return;
    if (ruhig.matches) return menue.close();
    menue.classList.add('zu');
    menue.addEventListener('animationend', () => { menue.classList.remove('zu'); menue.close(); }, { once: true });
  };
  oeffner?.addEventListener('click', () => {
    menue?.showModal();
    oeffner.setAttribute('aria-expanded', 'true');
  });
  menue?.addEventListener('close', () => {
    oeffner?.setAttribute('aria-expanded', 'false');
    oeffner?.focus();
  });
  menue?.addEventListener('cancel', (e) => { e.preventDefault(); zu(); });
  menue?.querySelector('[data-oc-zu]')?.addEventListener('click', zu);
  menue?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menue.close();
  });
  matchMedia('(min-width: 68.0625rem)').addEventListener('change', (e) => { if (e.matches && menue?.open) menue.close(); });
</script>
