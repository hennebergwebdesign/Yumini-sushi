---
import Logo from './ui/Logo.astro';

const nav = [
  { href: '/speisekarte/', label: 'Speisekarte' },
  { href: '/#standorte', label: 'Standorte' },
  { href: '/#preise', label: 'Preise' },
  { href: '/#feiern', label: 'Feiern' },
  { href: '/karriere/', label: 'Karriere' },
];
---
<header class="bar">
  <a class="brand" href="/" aria-label="Yumini, zur Startseite"><Logo hoehe={64} /></a>

  <div class="pill">
    <nav class="desk" aria-label="Hauptnavigation">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="res" href="/#reservieren">Tisch reservieren</a>

    <details class="mob">
      <summary aria-label="Menü öffnen"><span></span><span></span></summary>
      <nav aria-label="Mobile Navigation">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a class="mobres" href="/#reservieren">Tisch reservieren</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .bar {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 1rem var(--gutter) 0;
    pointer-events: none;
  }
  .brand {
    pointer-events: auto;
    justify-self: start;
    display: inline-flex;
    text-decoration: none;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.55));
  }
  .pill {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.3rem 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(3 5 4 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .desk ul {
    display: flex;
    gap: 0.1rem;
  }
  .desk a {
    display: block;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s, background-color 0.2s;
  }
  .desk a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.09);
  }
  .res {
    display: grid;
    place-items: center;
    min-block-size: 2.5rem;
    padding-inline: 1.1rem;
    margin-inline-start: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .res:hover {
    border-color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .mob {
    display: none;
  }
  summary {
    list-style: none;
    display: grid;
    place-items: center;
    gap: 5px;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    cursor: pointer;
    align-content: center;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    display: block;
    inline-size: 1.1rem;
    block-size: 2px;
    background: var(--text);
  }
  .mob nav {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    inline-size: min(20rem, 86vw);
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--r4);
    background: rgb(3 5 4 / 0.97);
  }
  .mob li a {
    display: block;
    padding: 0.85rem 0.75rem;
    text-decoration: none;
    font-size: 1.125rem;
  }
  .mob .mobres {
    margin-block-start: 0.5rem;
    border-radius: var(--r2);
    background: var(--brand-red);
    text-align: center;
    font-weight: 500;
  }

  @media (max-width: 62rem) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .desk,
    .res {
      display: none;
    }
    .mob {
      display: block;
    }
    .pill {
      padding: 0.3rem;
      justify-self: end;
    }
    .brand :global(img) {
      block-size: 3rem;
    }
  }
</style>
