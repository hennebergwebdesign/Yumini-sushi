---
// Gezeichnete Sushi-Elemente als Platzhalter bis zum Fotoshooting. Einmal je Seite einbinden,
// danach überall mit <use href="#maki"> verwenden.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="maki" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="46" fill="#1a2320" />
      <circle cx="50" cy="50" r="46" fill="none" stroke="#2c3833" stroke-width="2" />
      <circle cx="50" cy="50" r="36" fill="#f4f1ea" />
      <g fill="#e6e0d3">
        <circle cx="30" cy="32" r="1.6" /><circle cx="68" cy="30" r="1.6" /><circle cx="74" cy="56" r="1.6" />
        <circle cx="62" cy="72" r="1.6" /><circle cx="36" cy="70" r="1.6" /><circle cx="24" cy="52" r="1.6" />
      </g>
      <circle cx="50" cy="50" r="17" fill="#f27a55" />
      <circle cx="50" cy="50" r="17" fill="none" stroke="#ffb199" stroke-width="2" opacity="0.7" />
