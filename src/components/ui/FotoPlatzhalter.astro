---
// Leere Fläche an Stelle eines Fotos, das noch fehlt. Bewusst kein fremdes Bild (Wunsch des Inhabers, 21.10.2026).
interface Props { text?: string; class?: string }
const { text = 'Foto folgt', class: klasse } = Astro.props;
---
<div class:list={['ph', klasse]} role="img" aria-label={text}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
  <span>{text}</span>
</div>

<style>
  .ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    inline-size: 100%;
    block-size: 100%;
    border: 1px dashed var(--border);
    border-radius: inherit;
    background: #11161a;
    color: var(--text-muted);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  svg {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    opacity: 0.7;
  }
</style>
