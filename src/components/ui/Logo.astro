---
// Original SVG von yumini.de (weiße Wortmarke mit rotem Kreis hinter dem M). Nur auf dunklem Grund verwenden.
interface Props { hoehe?: number }
const { hoehe = 40 } = Astro.props;
---
<img src="/images/logo.svg" alt="Yumini" width={Math.round(hoehe * (200 / 70))} height={hoehe} class="logo" />

<style>
  .logo {
    display: block;
    block-size: auto;
    inline-size: auto;
  }
</style>
