---
// Fünf Sterne, anteilig gefüllt. Ohne Wert bleiben sie Umriss.
interface Props { wert: number | null; groesse?: string }
const { wert, groesse = '0.8rem' } = Astro.props;
const pct = wert == null ? 0 : Math.max(0, Math.min(5, wert)) * 20;
const pfad = 'M10 1.8l2.4 5.2 5.6.6-4.2 3.8 1.2 5.6L10 14.3 5 17l1.2-5.6L2 7.6l5.6-.6z';
---
<span class="sterne" style={`--g:${groesse};--p:${pct}%`} aria-hidden="true">
  <span class="row base">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20"><path d={pfad} /></svg>)}</span>
  <span class="row fill">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20"><path d={pfad} /></svg>)}</span>
</span>

<style>
  .sterne { position: relative; display: inline-block; line-height: 0; }
  .row { display: flex; gap: 1px; }
  svg { inline-size: var(--g); block-size: var(--g); }
  .base svg { fill: none; stroke: var(--coral-soft); stroke-width: 1.2; }
  .fill { position: absolute; inset: 0; inline-size: var(--p); overflow: clip; }
  .fill svg { flex: none; fill: var(--coral-soft); stroke: var(--coral-soft); stroke-width: 1.2; }
</style>
