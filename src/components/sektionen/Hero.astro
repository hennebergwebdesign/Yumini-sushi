---
import Button from '../ui/Button.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="art" aria-hidden="true">
    <svg viewBox="0 0 640 640" role="presentation">
      <defs>
        <radialGradient id="glow" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#d92129" stop-opacity="0.55" />
          <stop offset="0.7" stop-color="#d92129" stop-opacity="0.22" />
          <stop offset="1" stop-color="#d92129" stop-opacity="0.08" />
        </radialGradient>
        <radialGradient id="plate" cx="50%" cy="42%" r="60%">
          <stop offset="0" stop-color="#1b2420" />
          <stop offset="1" stop-color="#0a0f0d" />
        </radialGradient>
      </defs>
      <circle cx="320" cy="320" r="300" fill="url(#glow)" />
      <circle class="ring" cx="320" cy="320" r="300" fill="none" stroke="#ff8f86" stroke-opacity="0.55" stroke-width="1.5" />
      <g class="plate">
        <ellipse cx="320" cy="470" rx="250" ry="28" fill="#000" opacity="0.45" />
        <circle cx="320" cy="320" r="214" fill="url(#plate)" stroke="#2a3530" stroke-width="3" />
        <circle cx="320" cy="320" r="176" fill="none" stroke="#2a3530" stroke-width="1.5" />
        <use href="#maki" x="196" y="186" width="116" height="116" />
        <use href="#maki" x="318" y="170" width="116" height="116" />
        <use href="#maki" x="256" y="292" width="116" height="116" />
        <use href="#nigiri" x="150" y="330" width="150" height="96" transform="rotate(-8 225 378)" />
        <use href="#nigiri" x="352" y="320" width="150" height="96" transform="rotate(10 427 368)" />
        <use href="#ginger" x="420" y="236" width="70" height="44" />
        <use href="#wasabi" x="186" y="288" width="44" height="44" />
      </g>
    </svg>
  </div>

  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">
        <span class="o">Yumini</span>
        <span class="l">Japanese Sushi <span class="amp">&amp;</span> Grill</span>
      </h1>
      <p class="lead">All you can eat an fünf Standorten in Nordrhein-Westfalen. Zwei Stunden Sushi und Grill, so viel Sie möchten.</p>
      <div class="actions">
        <Button href="/reservieren/" variant="primary" size="lg">Tisch reservieren</Button>
        <Button href="/speisekarte/" variant="outline" size="lg">Speisekarte ansehen</Button>
      </div>
    </div>
  </div>

  <a class="scroll" href="#vertrauen" aria-label="Weiter zu den Bewertungen"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: grid;
    align-items: center;
    padding-block: 8rem 5rem;
    overflow: clip;
    background:
      radial-gradient(60% 50% at 78% 50%, rgb(217 33 41 / 0.14), transparent 70%),
      var(--black);
  }
  .grid {
    position: relative;
    z-index: 1;
  }
  .copy {
    max-inline-size: 52rem;
    display: grid;
    gap: 1.75rem;
  }
  h1 {
    display: grid;
    font-size: clamp(2.5rem, 4.9vw, 4.25rem);
    line-height: 1.02;
  }
  .o {
    font-weight: 500;
  }
  .l {
    font-weight: 300;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .amp {
    color: var(--coral-soft);
    font-weight: 500;
  }
  .lead {
    max-inline-size: 30rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .art {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: clamp(-7rem, -4vw, -1rem);
    inline-size: min(46vw, 44rem);
    aspect-ratio: 1;
    translate: 0 -50%;
    pointer-events: none;
  }
  .ring {
    transform-origin: 320px 320px;
    animation: spin 90s linear infinite;
    stroke-dasharray: 3 9;
  }
  .plate {
    transform-origin: 320px 320px;
    animation: float 9s ease-in-out infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes float {
    50% { transform: translateY(-8px) rotate(1.2deg); }
  }
  .scroll {
    position: absolute;
    inset-block-end: 1.75rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 1.75rem;
    block-size: 2.75rem;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-block-start: 0.5rem;
    z-index: 1;
  }
  .scroll span {
    inline-size: 4px;
    block-size: 8px;
    border-radius: 2px;
    background: var(--text);
    animation: drip 2s var(--ease) infinite;
  }
  @keyframes drip {
    0% { opacity: 0; translate: 0 -2px; }
    40% { opacity: 1; }
    100% { opacity: 0; translate: 0 12px; }
  }

  @media (max-width: 52rem) {
    .hero {
      align-items: end;
      padding-block: 7rem 5.5rem;
      background: var(--black);
    }
    .art {
      inset-block: 4.5rem auto;
      inset-inline: 50% auto;
      translate: -50% 0;
      inline-size: min(110vw, 30rem);
      opacity: 0.9;
    }
    .copy {
      padding-block-start: min(78vw, 26rem);
    }
    .l {
      white-space: normal;
    }
    .actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
