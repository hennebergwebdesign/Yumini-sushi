---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { fotos, gerichte } from '../../lib/bilder';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="art">
    <div class="glow" aria-hidden="true"></div>
    <div class="ring" aria-hidden="true"></div>
    <div class="disc">
      <Image
        src={fotos.sushiPlatte}
        alt="Nigiri mit Lachs, Garnele, Aal und Rogen auf einer Schieferplatte"
        widths={[480, 720, 960]}
        sizes="(max-width: 52rem) 90vw, 46vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <Image class="fl f1" src={gerichte.sake} alt="" aria-hidden="true" widths={[160, 320]} sizes="12rem" loading="eager" />
    <Image class="fl f2" src={gerichte.ikura} alt="" aria-hidden="true" widths={[120, 240]} sizes="8rem" loading="eager" />
    <Image class="fl f3" src={gerichte['tempura-california']} alt="" aria-hidden="true" widths={[160, 320]} sizes="11rem" loading="eager" />
  </div>

  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">
        <span class="o">Yumini</span>
        <span class="l">Japanese Sushi <span class="amp">&amp;</span> Grill</span>
      </h1>
      <p class="lead">All you can eat in Bochum, Dortmund, Gelsenkirchen, Lüdenscheid und Siegen. Über 100 warme und kalte Speisen, bestellt per Tablet.</p>
      <div class="actions">
        <Button href="/reservieren/" variant="primary" size="lg">Tisch reservieren</Button>
        <Button href="/speisekarte/" variant="outline" size="lg">Speisekarte ansehen</Button>
      </div>
    </div>
  </div>

  <a class="scroll" href="#vertrauen" aria-label="Weiter nach unten"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: grid;
    align-items: center;
    padding-block: 8rem 5rem;
    overflow: clip;
    background: var(--black);
  }
  .grid {
    position: relative;
    z-index: 2;
  }
  .copy {
    max-inline-size: 52rem;
    display: grid;
    gap: 1.75rem;
  }
  h1 {
    display: grid;
    font-size: clamp(2.5rem, 4.9vw, 4.25rem);
    line-height: 1.02;
  }
  .o { font-weight: 500; }
  .l {
    font-weight: 300;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .amp {
    color: var(--coral-soft);
    font-weight: 500;
  }
  .lead { max-inline-size: 30rem; }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .art {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: clamp(-4rem, 3vw, 4rem);
    inline-size: min(41vw, 40rem);
    aspect-ratio: 1;
    translate: 0 -50%;
    z-index: 1;
  }
  .glow {
    position: absolute;
    inset: -22%;
    background: radial-gradient(closest-side, rgb(217 33 41 / 0.42), rgb(217 33 41 / 0.12) 60%, transparent);
  }
  .ring {
    position: absolute;
    inset: -7%;
    border-radius: 50%;
    border: 1.5px dashed rgb(255 143 134 / 0.55);
    animation: spin 120s linear infinite;
  }
  .disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: clip;
    border: 2px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 40px 80px -30px #000;
  }
  .disc :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 38% 55%;
    scale: 1.08;
    animation: slow 24s ease-in-out infinite alternate;
  }
  .art :global(.fl) {
    position: absolute;
    block-size: auto;
    filter: drop-shadow(0 18px 20px rgb(0 0 0 / 0.6));
    animation: float 7s ease-in-out infinite;
  }
  .art :global(.f1) { inline-size: 30%; inset-block-end: 4%; inset-inline-start: -12%; rotate: -8deg; }
  .art :global(.f2) { inline-size: 17%; inset-block-start: 2%; inset-inline-start: 6%; rotate: 10deg; animation-delay: -2s; }
  .art :global(.f3) { inline-size: 28%; inset-block-end: -6%; inset-inline-end: 4%; rotate: 6deg; animation-delay: -4s; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes slow { to { scale: 1.16; } }
  @keyframes float { 50% { translate: 0 -10px; } }

  .scroll {
    position: absolute;
    inset-block-end: 1.75rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 1.75rem;
    block-size: 2.75rem;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-block-start: 0.5rem;
    z-index: 3;
  }
  .scroll span {
    inline-size: 4px;
    block-size: 8px;
    border-radius: 2px;
    background: var(--text);
    animation: drip 2s var(--ease) infinite;
  }
  @keyframes drip {
    0% { opacity: 0; translate: 0 -2px; }
    40% { opacity: 1; }
    100% { opacity: 0; translate: 0 12px; }
  }

  @media (max-width: 52rem) {
    .hero {
      align-items: end;
      padding-block: 6.5rem 5.5rem;
    }
    .art {
      inset-block-start: 6.5rem;
      inset-inline: 50% auto;
      translate: -50% 0;
      inline-size: min(78vw, 22rem);
    }
    .copy { padding-block-start: min(92vw, 27rem); }
    .l { white-space: normal; }
    .actions :global(.btn) { flex: 1 1 100%; }
  }
</style>
