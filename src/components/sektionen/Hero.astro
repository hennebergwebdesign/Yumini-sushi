---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Sterne from '../ui/Sterne.astro';
import { fotos, kategorien } from '../../lib/bilder';
import { bewertungen, komma } from '../../lib/bewertungen';

// Werte und Quellen in src/lib/bewertungen.ts. Google ist vorläufig, Trustpilot hat noch keinen belegten Wert.
const orbit = [
  { bild: kategorien.sushi, name: 'Sushi' },
  { bild: kategorien.grill, name: 'Grill' },
  { bild: kategorien.salad, name: 'Reis' },
  { bild: kategorien.dinner, name: 'Dinner' },
  { bild: kategorien.dessert, name: 'Dessert' },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">
        <span class="kicker">Yumini Japanese Sushi <span class="amp">&amp;</span> Grill</span>
        <span class="big display">All you<br />can eat</span>
      </h1>
      <p class="lead">All you can eat Sushi und Grill mit über 100 warmen und kalten Speisen, bestellt per Tablet. In Bochum, Dortmund, Gelsenkirchen, Lüdenscheid und Siegen.</p>
      <div class="actions">
        <Button href="/#reservieren" variant="primary" size="lg">Tisch reservieren</Button>
        <Button href="/speisekarte/" variant="outline" size="lg">Sushi Speisekarte ansehen</Button>
      </div>

      <ul class="trust" aria-label="Bewertungen unserer Gäste">
        {bewertungen.map((p) => (
          <li>
            <a href="#bewertungen" class="widget" aria-label={p.wert ? `${p.name}: ${komma(p.wert)} von 5 Sternen${p.anzahl ? `, ${p.anzahl.toLocaleString('de-DE')} Bewertungen` : ''}` : `${p.name}: Bewertung folgt`}>
              <span class="logo" aria-hidden="true"><img src={p.logo} alt="" width="20" height="20" /></span>
              <span class="meta">
                <b>{p.name}</b>
                <Sterne wert={p.wert} groesse="0.8rem" />
              </span>
              <span class="val">
                {p.wert ? <><b>{komma(p.wert)}</b>{p.anzahl && <small>{p.anzahl.toLocaleString('de-DE')} Bewertungen</small>}</> : <span class="fehlt">[[FEHLT]]</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="turn">
      <div class="ring"></div>
      <div class="plate">
        <Image src={fotos.schieferRund} alt="Nigiri und Sushi auf einer Schieferplatte, serviert bei Yumini" title="All you can eat Sushi bei Yumini" widths={[480, 720, 960]} sizes="(max-width: 52rem) 80vw, 42vw" loading="eager" fetchpriority="high" />
      </div>
      <ul class="orbit" aria-hidden="true">
        {orbit.map((o, i) => (
          <li style={`--i:${i}`}>
            <span class="bowl"><Image src={o.bild} alt="" widths={[120, 240]} sizes="6rem" /></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: grid;
    align-items: center;
    padding-block: var(--kopf) clamp(1.5rem, 4svh, 3rem);
    overflow: clip;
    background: var(--black);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4svh, 3rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.3rem;
    max-inline-size: 38rem;
    position: relative;
    z-index: 2;
  }
  h1 {
    display: grid;
    gap: 0.9rem;
  }
  .kicker {
    font-size: var(--fs-lead);
    font-weight: 300;
    letter-spacing: 0;
  }
  .amp {
    color: var(--coral-soft);
    font-weight: 500;
  }
  .big {
    font-size: clamp(2.4rem, min(1rem + 4.6vw, 11svh), 5rem);
  }
  .lead {
    max-inline-size: 32rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }
  .widget {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.8rem 0.45rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    text-decoration: none;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .widget:hover {
    border-color: var(--coral-soft);
    background: rgb(255 255 255 / 0.08);
  }
  .logo {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    background: #fff;
  }
  .logo img { inline-size: 1.15rem; block-size: 1.15rem; }
  .meta {
    display: grid;
    line-height: 1.1;
  }
  .meta b {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .val { display: grid; line-height: 1.1; }
  .val b { font-size: 1rem; font-weight: 600; }
  .val small { font-size: 0.6875rem; color: var(--text-muted); }
  .val .fehlt {
    font-size: 0.65rem;
    padding: 0 0.35em;
  }

  /* Drehteller: das Brett dreht sich langsam, kleine Schalen kreisen darum, jede bleibt aufrecht */
  .turn {
    position: relative;
    inline-size: min(62vw, 34rem, 40svh);
    aspect-ratio: 1;
    margin-inline: auto;
    margin-block: clamp(1.5rem, 5vw, 2.5rem);
    order: -1;
  }
  .ring {
    position: absolute;
    inset: -3%;
    border-radius: 50%;
    border: 2px solid var(--brand-red);
  }
  .plate {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: clip;
    animation: turn 70s linear infinite;
  }
  .plate :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .orbit {
    position: absolute;
    inset: -17%;
    animation: turn 110s linear infinite reverse;
  }
  .orbit li {
    position: absolute;
    inset: 0;
    rotate: calc(var(--i) * 72deg);
  }
  .bowl {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: clamp(3.2rem, 8vw, 5.2rem);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: clip;
    border: 3px solid var(--black);
    outline: 1.5px solid var(--border);
    animation: untwist 110s linear infinite;
    rotate: calc(var(--i) * -72deg);
  }
  .bowl :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  @keyframes turn { to { rotate: 360deg; } }
  @keyframes untwist { to { rotate: calc(var(--i) * -72deg + 360deg); } }

  @media (min-width: 62rem), (orientation: landscape) and (max-height: 34rem) and (min-width: 36rem) {
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
    .turn {
      order: 0;
      margin-block: 0;
      inline-size: min(40vw, 38rem, 62svh);
    }
  }
  @media (orientation: landscape) and (max-height: 34rem) {
    .hero { padding-block: 4.5rem 1rem; }
    .lead { display: none; }
    .big { font-size: clamp(1.8rem, 11svh, 3rem); }
  }
  @media (max-width: 52rem) {
    .trust {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.4rem;
    }
    .widget {
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.45rem 0.3rem;
      border-radius: var(--r3);
      text-align: center;
    }
    .logo { inline-size: 1.6rem; block-size: 1.6rem; }
    .logo img { inline-size: 0.95rem; block-size: 0.95rem; }
    .meta { justify-items: center; }
    .val { justify-items: center; }
    .copy { gap: 1rem; }
    .actions { flex-wrap: nowrap; }
    .actions :global(.btn) {
      flex: 1 1 0;
      min-inline-size: 0;
      padding-inline: 0.5rem;
      white-space: normal;
      text-align: center;
      font-size: 0.9375rem;
      min-block-size: 3.25rem;
    }
  }
</style>
