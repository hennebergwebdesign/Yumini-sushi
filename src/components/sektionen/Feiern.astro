---
import { Image, getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { fotos, gerichte } from '../../lib/bilder';

const bg = await getImage({ src: fotos.sushiPlatte, width: 1800, format: 'webp' });
// Platzhaltertexte, vom Inhaber zu bestätigen. Keine Preise, Räume oder Leistungen genannt, die nicht belegt sind.
const anlaesse = [
  { t: 'Geburtstag', x: 'Feiern Sie Ihren Geburtstag mit Familie und Freunden an einem Tisch, an dem jeder Sushi, Grillspezialitäten und Desserts nach Lust und Laune bestellt. Sie reservieren, wir decken ein.' },
  { t: 'Firmenfeier', x: 'Vom Teamessen bis zur Weihnachtsfeier: Alle bestellen, was sie mögen, und niemand muss vorher wählen. Das macht den Abend für Gruppen jeder Größe einfach zu planen.' },
  { t: 'Gruppen ab 16 Personen', x: 'Die Anfrage geht direkt an den gewählten Standort, der sich bei Ihnen meldet.' },
];
---
<section id="feiern" class="feiern fullh" aria-labelledby="feiern-title" style={`--bg:url(${bg.src})`}>
  <div class="wrap grid">
    <div class="visual" aria-hidden="true">
      <span class="disc"></span>
      <Image class="a" src={gerichte['sake-aburi']} alt="" widths={[200, 400]} sizes="12rem" />
      <Image class="b" src={gerichte['tekka-maki']} alt="" widths={[200, 400]} sizes="14rem" />
      <Image class="c" src={gerichte['ebi-tempura']} alt="" widths={[200, 400]} sizes="12rem" />
    </div>

    <div class="copy">
      <p class="eyebrow">Feiern und Gruppen</p>
      <h2 id="feiern-title" class="h2">Geburtstag und Firmenfeier bei Yumini.</h2>
      <ul class="list">
        {anlaesse.map((a) => (
          <li>
            <h3>{a.t}</h3>
            <p>{a.x}</p>
          </li>
        ))}
      </ul>
      <Button href="/feiern/" variant="primary">Feier jetzt anfragen</Button>
    </div>
  </div>
</section>

<style>
  .feiern { position: relative; isolation: isolate; background: var(--black) var(--bg) center / cover no-repeat; }
  .feiern::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(3 5 4 / 0.86); }
  .grid { display: grid; gap: clamp(2rem, 5svh, 3.5rem); align-items: center; }
  .copy { display: grid; gap: 1.75rem; justify-items: start; }
  .list { display: grid; inline-size: 100%; }
  .list li { padding-block: clamp(0.8rem, 2svh, 1.1rem); border-block-start: 1px solid var(--border); transition: padding-inline-start 0.3s var(--ease); }
  .list li:last-child { border-block-end: 1px solid var(--border); }
  .list li:hover { padding-inline-start: 0.75rem; }
  .list h3 { font-size: var(--fs-h3); margin-block-end: 0.2rem; }
  .list p { color: var(--text-muted); }
  .visual { position: relative; aspect-ratio: 1; max-inline-size: 30rem; inline-size: 100%; margin-inline: auto; }
  .disc { position: absolute; inset: 6%; border-radius: 50%; border: 2px solid var(--brand-red); background: rgb(3 5 4 / 0.7); }
  .visual :global(img) { position: absolute; block-size: auto; filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.55)); }
  .visual :global(.a) { inline-size: 46%; inset-block-start: 20%; inset-inline-start: 12%; rotate: -10deg; }
  .visual :global(.b) { inline-size: 44%; inset-block-start: 52%; inset-inline-start: 38%; rotate: 6deg; }
  .visual :global(.c) { inline-size: 42%; inset-block-start: 14%; inset-inline-start: 48%; rotate: 12deg; }
  @media (min-width: 62rem) { .grid { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: clamp(3rem, 6vw, 7rem); } .visual { max-inline-size: min(30rem, 52svh); } .list p { max-inline-size: none; } }
</style>
