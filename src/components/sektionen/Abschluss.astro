---
import { getImage } from 'astro:assets';
import { standorte } from '../../lib/standorte';
import Button from '../ui/Button.astro';
import { fotos } from '../../lib/bilder';

const bg = await getImage({ src: fotos.nigiriSchiefer, width: 1600, format: 'webp' });
const fill = await getImage({ src: fotos.sushiPlatte, width: 1600, format: 'webp' });
---
<section id="abschluss" class="end" aria-labelledby="end-title" data-bg={bg.src} data-fill={fill.src}>
  <div class="wrap inner">
    <h2 id="end-title" class="mega">Ihr Tisch wartet</h2>
    <p class="lead">Wählen Sie Ihren Standort und reservieren Sie in unter einer Minute.</p>
    <ul class="locs">
      {standorte.map((s) => (
        <li><Button href={`/${s.id}/#reservieren`} variant="outline">Yumini {s.name}</Button></li>
      ))}
    </ul>
    <Button href="/#reservieren" variant="primary" size="lg">Tisch reservieren</Button>
  </div>
</section>

<style>
  .end { position: relative; isolation: isolate; overflow: clip; padding-block: clamp(5rem, 11vw, 9rem); background: var(--black) var(--bg) center / cover no-repeat; text-align: center; }
  .end::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(3 5 4 / 0.86); }
  .inner { display: grid; gap: 1.5rem; justify-items: center; }
  .mega {
    font-family: var(--display); font-weight: 900; font-stretch: 125%; text-transform: uppercase;
    font-size: clamp(3rem, 12.5vw, 11rem); line-height: 0.9; letter-spacing: -0.02em; color: var(--coral-soft);
  }
  @supports (-webkit-background-clip: text) or (background-clip: text) {
    .mega { color: transparent; background: var(--fill) center 64% / 130% no-repeat; -webkit-background-clip: text; background-clip: text; -webkit-text-stroke: 1px rgb(255 255 255 / 0.3); }
  }
  .locs { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
</style>
