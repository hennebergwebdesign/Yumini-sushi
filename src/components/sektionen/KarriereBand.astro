---
import { Image, getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { kategorien } from '../../lib/bilder';

// Verstärkung gesucht: flach abgedunkeltes Speisefoto als Grund, vier Bereichsfotos als Kacheln. Keine Personen, keine Stockfotos von Menschen.
const bg = await getImage({ src: kategorien.grill, width: 1800, format: 'webp' });
const bereiche = [
  { t: 'Sushi', bild: kategorien.sushi },
  { t: 'Küche', bild: kategorien.dinner },
  { t: 'Grill', bild: kategorien.grill },
  { t: 'Service und Theke', bild: kategorien.dessert },
];
---
<section class="band" aria-labelledby="karriere-title" style={`--bg:url(${bg.src})`}>
  <div class="wrap row">
    <div class="txt">
      <p class="eyebrow">Karriere bei Yumini</p>
      <h2 id="karriere-title" class="display titel">Wir suchen<br />Verstärkung.</h2>
      <p class="lead">An allen fünf Standorten für Küche, Sushi, Grill, Service und Theke. Bewerben in zwei Minuten, ohne Lebenslauf.</p>
      <div class="act">
        <Button href="/karriere/#bewerben" variant="primary" size="lg">In 2 Minuten bewerben</Button>
        <Button href="/karriere/" variant="outline" size="lg">Jobs ansehen</Button>
      </div>
    </div>

    <ul class="kacheln" aria-label="Bereiche mit offenen Stellen">
      {bereiche.map((b) => (
        <li class="kachel">
          <Image src={b.bild} alt={`${b.t} bei Yumini`} title={`Job ${b.t}`} widths={[320, 640]} sizes="(max-width: 52rem) 45vw, 16rem" />
          <span>{b.t}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--black) var(--bg) center / cover no-repeat;
  }
  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(3 5 4 / 0.82);
  }
  .row {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .txt { display: grid; gap: 1.25rem; justify-items: start; }
  .titel { font-size: clamp(1.9rem, 0.5rem + 3.4vw, 3.75rem); }
  .act { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .kacheln {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .kachel {
    position: relative;
    overflow: clip;
    aspect-ratio: 4 / 3;
    border-radius: var(--r3);
    border: 1px solid var(--border);
    transition: border-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .kachel:hover { border-color: var(--coral-soft); transform: translateY(-4px); }
  .kachel :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .kachel:hover :global(img) { transform: scale(1.07); }
  .kachel span {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.6rem 0.9rem;
    background: rgb(3 5 4 / 0.82);
    font-weight: 500;
    font-size: var(--fs-sm);
  }
  @media (min-width: 62rem) {
    .row { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
    .kacheln { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kachel:nth-child(even) { translate: 0 1.5rem; }
  }
</style>
