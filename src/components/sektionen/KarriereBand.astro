---
import Button from '../ui/Button.astro';
---
<section class="band paper-2" aria-labelledby="karriere-title">
  <div class="wrap row">
    <div>
      <h2 id="karriere-title">Wir suchen Verstärkung an allen Standorten.</h2>
      <p class="muted">Küche, Sushi, Grill, Service und Theke. Bewerben in zwei Minuten.</p>
    </div>
    <Button href="/karriere/" variant="outline">Jobs ansehen</Button>
  </div>
</section>

<style>
  .band {
    background: var(--paper-2);
    color: var(--ink);
    padding-block: 2.5rem;
  }
  .muted {
    color: var(--ink-muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  h2 {
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    margin-block-end: 0.25rem;
  }
  .band :global(.btn.outline) {
    border-color: var(--border-ink);
  }
</style>
