---
import Button from '../ui/Button.astro';
import Sterne from '../ui/Sterne.astro';
import { standorte } from '../../lib/standorte';
import daten from '../../data/google-bewertungen.json';
import ta from '../../data/tripadvisor-bewertungen.json';

// Bewertungen von Tripadvisor und Google in einem durchlaufenden Band, ohne Plattform Siegel (Wunsch des Inhabers, 21.10.2026).
// Nur echte Stimmen (data/tripadvisor-bewertungen.json, data/google-bewertungen.json), keine Platzhalter.
const name = (id: string | null) => (id ? standorte.find((s) => s.id === id)?.name ?? id : '');
// Nur ausführliche Stimmen, kurze Einzeiler wirken nicht glaubwürdig.
const MIN_ZEICHEN = 140;
type Stimme = { quelle: string; standort: string | null; name?: string; sterne?: number; text?: string };
const von = (liste: unknown, quelle: string) => (liste as Omit<Stimme, 'quelle'>[]).map((b) => ({ ...b, quelle }));
const tripadvisor = von(ta.bewertungen, 'Tripadvisor');
const google = von(daten.bewertungen, 'Google');
// abwechselnd, damit beide Quellen im Band gemischt laufen
const stimmen: Stimme[] = Array.from({ length: Math.max(tripadvisor.length, google.length) }, (_, i) => [tripadvisor[i], google[i]]).flat().filter((b) => b && (b.text?.length ?? 0) >= MIN_ZEICHEN);
---
<section id="bewertungen" class="bew" aria-labelledby="bew-title">
  <div class="wrap">
    <div class="head">
      <div class="titel">
        <p class="eyebrow">Bewertungen</p>
        <h2 id="bew-title" class="h2">Stimmen unserer Gäste.</h2>
      </div>
    </div>
  </div>

  <div class="marquee" role="region" aria-label="Bewertungen unserer Gäste von Tripadvisor und Google">
    <div class="track">
      {[0, 1].map((kopie) => (
        <ul class="gruppe" aria-hidden={kopie === 1 ? 'true' : undefined}>
          {stimmen.map((b) => (
            <li class="karte">
              <Sterne wert={b.sterne ?? 5} groesse="1rem" />
              <p class="zitat">„{b.text}“</p>
              <button type="button" class="mehrlesen" aria-expanded="false" hidden>Ganze Bewertung lesen</button>
              <p class="wer"><b>{b.name}</b><span>{b.quelle}, Yumini{b.standort ? ` ${name(b.standort)}` : ''}</span></p>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <div class="wrap fuss">
    <Button href="/#reservieren" variant="outline">Tisch reservieren</Button>
  </div>
</section>

<script>
  // Zitat ausklappen, solange eine Karte offen ist, hält das Band an. Der Knopf erscheint nur bei gekürztem Text.
  const karten = document.querySelectorAll<HTMLElement>('#bewertungen .karte');
  const pruefen = () => karten.forEach((k) => {
    const z = k.querySelector<HTMLElement>('.zitat')!;
    const b = k.querySelector<HTMLButtonElement>('.mehrlesen')!;
    b.hidden = !(k.classList.contains('offen') || z.scrollHeight > z.clientHeight + 1);
  });
  pruefen();
  addEventListener('resize', pruefen);
  document.querySelector('#bewertungen')?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.mehrlesen');
    if (!b) return;
    const k = b.closest('.karte')!;
    const auf = k.classList.toggle('offen');
    b.setAttribute('aria-expanded', String(auf));
    b.textContent = auf ? 'Weniger anzeigen' : 'Ganze Bewertung lesen';
  });
</script>

<style>
  .bew {
    background: #11161a;
    padding-block: var(--space-section);
    overflow: clip;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    margin-block-end: clamp(1.75rem, 4vw, 3rem);
  }
  .titel { display: grid; gap: 0.75rem; }
  .marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .track {
    display: flex;
    inline-size: max-content;
    animation: lauf 190s linear infinite;
  }
  .marquee:has(.offen) .track,
  .marquee:hover .track,
  .marquee:focus-within .track { animation-play-state: paused; }
  .gruppe {
    display: flex;
    flex: none;
    gap: 1rem;
    padding-inline-end: 1rem;
  }
  @keyframes lauf { to { translate: -50% 0; } }

  .karte {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    inline-size: clamp(17rem, 28vw, 24rem);
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--r4);
    background: #1a2123;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .karte:hover { border-color: var(--coral-soft); background: #1f292c; }
  .zitat {
    font-size: var(--fs-base);
    font-weight: 300;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 7;
    line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .zitat { white-space: pre-line; }
  .karte.offen { align-self: start; }
  .karte.offen .zitat { display: block; -webkit-line-clamp: unset; line-clamp: unset; overflow: visible; }
  .mehrlesen {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--coral-soft);
    font: inherit;
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .mehrlesen[hidden] { display: none; }
  .wer { display: grid; gap: 0.1rem; margin-block-start: auto; font-size: var(--fs-sm); }
  .wer b { font-weight: 500; }
  .wer span { color: var(--text-muted); font-size: var(--fs-xs); }

  .fuss {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .marquee { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
    .gruppe[aria-hidden='true'] { display: none; }
  }
</style>
