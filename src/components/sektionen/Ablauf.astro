---
import { Image } from 'astro:assets';
import Stempel from '../ui/Stempel.astro';
import { fotos, gerichte } from '../../lib/bilder';

// Zahlen aus den Regeln der Bestandsseite: pro Bestellrunde 6 Speisen mittags, 5 abends, je Person.
const dishes = ['sake', 'maguro', 'ebi', 'tempura-california', 'yaki-tori', 'tekka-maki'] as const;
---
<section id="ablauf" class="ablauf" aria-labelledby="ablauf-title">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">So funktioniert All you can eat</p>
        <h2 id="ablauf-title" class="h2">Platz nehmen, bestellen, genießen.</h2>
      </div>
      <div class="stamp" aria-hidden="true"><Stempel zeichen="2" /></div>
    </div>

    <ol class="steps">
      <li class="step">
        <div class="vis v1" aria-hidden="true">
          <div class="ticket">
            <span class="t1">Tisch für 4</span>
            <span class="t2">Fr, 19:00 Uhr</span>
            <span class="t3"><i></i>Bochum</span>
          </div>
        </div>
        <span class="n" aria-hidden="true">1</span>
        <h3>Platz nehmen</h3>
        <p class="muted">Sie reservieren online oder kommen spontan vorbei. Wir führen Sie an Ihren Tisch.</p>
      </li>

      <li class="step">
        <div class="vis v2" aria-hidden="true">
          <div class="tab">
            <span class="tabbar"><b>Runde 1</b><em>5 von 5</em></span>
            <ul class="tabgrid">
              {dishes.map((d) => (<li><Image src={gerichte[d]} alt="" widths={[120, 240]} sizes="6rem" /></li>))}
            </ul>
          </div>
        </div>
        <span class="n" aria-hidden="true">2</span>
        <h3>Am Tablet bestellen</h3>
        <p class="muted">Pro Runde und Person bis zu 6 Speisen mittags und 5 Speisen abends. Die nächste Runde bestellen Sie, sobald Sie bereit sind.</p>
      </li>

      <li class="step">
        <div class="vis v3" aria-hidden="true">
          <div class="clock">
            <svg viewBox="0 0 220 220">
              <circle class="track" cx="110" cy="110" r="100" />
              <circle class="fill" cx="110" cy="110" r="100" pathLength="100" />
            </svg>
            <Image src={fotos.schieferRund} alt="" widths={[240, 480]} sizes="12rem" />
          </div>
        </div>
        <span class="n" aria-hidden="true">3</span>
        <h3>Zwei Stunden genießen</h3>
        <p class="muted">Sushi, Grill, warme Gerichte, Suppen und Salate, so oft Sie möchten. In Dortmund haben Sie 2,5 Stunden. Getränke sind nicht inklusive.</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .ablauf { position: relative; padding-block: var(--space-section); background: #0a0d0c; overflow: clip; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-block-end: clamp(2.5rem, 5vw, 4rem); }
  .head > div:first-child { display: grid; gap: 0.75rem; max-inline-size: 40rem; }
  .stamp { inline-size: clamp(5.5rem, 12vw, 9rem); flex: none; animation: turn 40s linear infinite; }
  @keyframes turn { to { rotate: 360deg; } }

  .steps { display: grid; gap: 1.5rem; counter-reset: s; }
  .step {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r3);
    background: #11161a;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .step:hover { border-color: var(--coral-soft); transform: translateY(-4px); }
  .vis { min-inline-size: 0; inline-size: 100%; display: grid; place-items: center; aspect-ratio: 16 / 10; margin-block-end: 0.75rem; border-radius: var(--r2); background: #1a2123; overflow: clip; }
  .n {
    position: absolute; inset-block-start: calc(1.5rem + 0.75rem); inset-inline-start: 2.2rem;
    display: grid; place-items: center; inline-size: 2.6rem; block-size: 2.6rem; border-radius: 50%;
    background: var(--brand-red); font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: 1.1rem;
  }
  .step h3 { font-family: var(--display); font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 0; line-height: 1.1; }

  .ticket { display: grid; gap: 0.2rem; padding: 1rem 1.4rem; border-radius: var(--r2); background: var(--paper); color: var(--ink); rotate: -4deg; box-shadow: 0 14px 24px -12px #000; border-inline-start: 6px solid var(--brand-red); }
  .t1 { font-family: var(--display); font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: 1.1rem; }
  .t2 { font-size: 1rem; }
  .t3 { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--ink-muted); }
  .t3 i { inline-size: 0.6rem; block-size: 0.6rem; border-radius: 50%; background: var(--brand-red); }

  .tab { inline-size: 74%; padding: 0.55rem; border-radius: 0.7rem; background: #05080a; border: 3px solid #2b3430; }
  .tabbar { display: flex; justify-content: space-between; font-size: 0.7rem; padding: 0 0.2rem 0.4rem; }
  .tabbar em { font-style: normal; color: var(--coral-soft); }
  .tabgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.3rem; }
  .tabgrid li { display: grid; place-items: center; aspect-ratio: 1; border-radius: 0.4rem; background: #151c1e; }
  .tabgrid :global(img) { inline-size: 80%; block-size: auto; }

  .clock { position: relative; inline-size: 58%; aspect-ratio: 1; display: grid; place-items: center; }
  .clock svg { position: absolute; inset: -4%; inline-size: 108%; block-size: 108%; rotate: -90deg; }
  .clock :global(img) { inline-size: 80%; block-size: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; }
  .track { fill: none; stroke: rgb(255 255 255 / 0.14); stroke-width: 6; }
  .fill { fill: none; stroke: var(--brand-red); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 25; }
  @supports (animation-timeline: view()) {
    .fill { stroke-dashoffset: 100; animation: fillring linear both; animation-range: entry 30% cover 60%; }
    .fill:where(*) { animation-timeline: view(); }
  }
  @keyframes fillring { to { stroke-dashoffset: 0; } }

  @media (min-width: 62rem) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
