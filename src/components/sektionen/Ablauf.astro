---
import Button from '../ui/Button.astro';

const schritte = [
  { n: '1', titel: 'Platz nehmen', text: 'Sie reservieren oder kommen spontan vorbei. Wir führen Sie an Ihren Tisch.' },
  { n: '2', titel: 'Am Tablet bestellen', text: 'Pro Runde und Person bis zu 6 Speisen mittags und 5 Speisen abends. Die nächste Runde bestellen Sie, sobald Sie bereit sind.' },
  { n: '3', titel: 'Zwei Stunden genießen', text: 'Sushi, Grill und warme Gerichte, so oft Sie möchten. Getränke sind nicht inklusive.' },
];

const preise = [
  { name: 'Mittag', hinweis: 'Uhrzeit [[FEHLT]]' },
  { name: 'Abend', hinweis: 'Uhrzeit [[FEHLT]]' },
  { name: 'Wochenende und Feiertage', hinweis: 'Zeiten [[FEHLT]]' },
  { name: 'Kinder', hinweis: 'Altersgrenze [[FEHLT]]' },
];
---
<section id="ablauf" class="section paper" aria-labelledby="ablauf-title">
  <div class="wrap">
    <div class="layout">
      <div class="ringcol">
        <div class="ring" aria-hidden="true">
          <svg viewBox="0 0 220 220">
            <circle class="track" cx="110" cy="110" r="90" />
            <circle class="fill" cx="110" cy="110" r="90" pathLength="100" />
          </svg>
          <div class="mid"><b>2</b><span>Stunden</span></div>
        </div>
      </div>

      <div class="body">
        <p class="eyebrow">So funktioniert All you can eat</p>
        <h2 id="ablauf-title" class="h2">Drei Schritte, zwei Stunden, ein Preis.</h2>

        <ol class="steps">
          {schritte.map((s) => (
            <li>
              <span class="n" aria-hidden="true">{s.n}</span>
              <div>
                <h3>{s.titel}</h3>
                <p class="muted">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="prices">
      <ul class="cards">
        {preise.map((p) => (
          <li class="card">
            <h3>{p.name}</h3>
            <p class="price"><span class="fehlt">[[FEHLT: Preis]]</span></p>
            <p class="muted small"><span class="fehlt">{p.hinweis}</span></p>
          </li>
        ))}
      </ul>
      <div class="notes">
        <p class="small muted"><strong>Speisen übrig gelassen?</strong> Für nicht aufgegessene Speisen berechnen wir 1,00 € je Stück Sushi und Salat und 2,00 € je warmes Gericht. Der Erlös wird gespendet.</p>
        <p class="small muted">Alle Preise gelten an allen Standorten. Getränke sind nicht im Preis enthalten.</p>
        <Button href="/speisekarte/" variant="outline">Preise im Detail</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 3rem;
  }
  .ringcol {
    display: grid;
    place-items: start center;
  }
  .ring {
    position: relative;
    inline-size: min(70vw, 20rem);
    aspect-ratio: 1;
  }
  .ring svg {
    inline-size: 100%;
    block-size: 100%;
    rotate: -90deg;
  }
  .track {
    fill: none;
    stroke: var(--border-ink);
    stroke-width: 10;
  }
  .fill {
    fill: none;
    stroke: var(--brand-red);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 25;
  }
  @supports (animation-timeline: view()) {
    .fill {
      stroke-dashoffset: 100;
      animation: fillring linear both;
      animation-range: entry 20% cover 55%;
    }
    .fill:where(*) {
      animation-timeline: view();
    }
  }
  @keyframes fillring {
    to { stroke-dashoffset: 0; }
  }
  .mid {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
  }
  .mid b {
    font-size: clamp(4rem, 12vw, 6rem);
    font-weight: 500;
    line-height: 0.9;
  }
  .mid span {
    font-weight: 300;
    font-size: 1.25rem;
  }
  .body {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .steps {
    display: grid;
    gap: 1.75rem;
    margin-block-start: 1rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .n {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    border: 1.5px solid var(--brand-red);
    font-weight: 500;
    color: var(--brand-red);
  }
  .steps h3 {
    font-size: 1.375rem;
    margin-block-end: 0.25rem;
  }
  .prices {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 2rem;
  }
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .card {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border-ink);
    border-radius: var(--r3);
    background: #fff;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--brand-red);
    box-shadow: 0 14px 30px -18px rgb(17 21 19 / 0.4);
  }
  .card h3 {
    font-size: 1.125rem;
  }
  .price {
    font-size: 2rem;
    font-weight: 500;
  }
  .small {
    font-size: 0.9375rem;
  }
  .notes {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-inline-size: 46rem;
  }

  @media (min-width: 62rem) {
    .layout {
      grid-template-columns: 22rem 1fr;
      gap: 5rem;
      align-items: center;
    }
  }
</style>
