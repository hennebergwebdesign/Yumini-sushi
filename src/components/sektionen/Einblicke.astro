---
import { Image, getImage } from 'astro:assets';
import { fotos, kategorien, raeume } from '../../lib/bilder';
// Food Fotos vom Betreiber. Der Gastraum ist ein beschriftetes Symbolbild, bis das Fotoshooting vorliegt.
// Gäste und Team gibt es nie als Stockfoto (docs/plan.md, Abschnitt 12).
const fill = await getImage({ src: fotos.sushiPlatte, width: 1600, format: 'webp' });
---
<section class="einblicke fullh" aria-labelledby="einblicke-title">
  <div class="wrap">
    <p class="eyebrow">Einblicke</p>
    <h2 id="einblicke-title" class="mega" style={`--fill:url(${fill.src})`}>Yumini</h2>
    <p class="lead muted">So sieht ein Abend bei Yumini aus.</p>

    <ul class="mosaik">
      <li class="tile a"><Image src={fotos.sushiPlatte} alt="Nigiri auf Schiefer mit Stäbchen" title="Nigiri bei Yumini" widths={[600, 1000, 1400]} sizes="(max-width: 52rem) 100vw, 50vw" /></li>
      <li class="tile b"><Image src={kategorien.dinner} alt="Nigiri Auswahl auf dunklem Teller bei Yumini" title="Nigiri Auswahl" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /></li>
      <li class="tile c"><Image src={kategorien.grill} alt="Gegrilltes vom Teppanyaki Grill bei Yumini" title="Teppanyaki Grill" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /></li>
      <li class="tile d"><Image src={raeume.laternen.src} alt={raeume.laternen.alt} title="Symbolbild Gastraum" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /><span class="sym">Symbolbild</span></li>
      <li class="tile e"><Image src={kategorien.dessert} alt="Grüner Tee Eis in der Schale als Dessert bei Yumini" title="Dessert Grüner Tee Eis" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /></li>
    </ul>
  </div>
</section>

<style>
  .einblicke { background: var(--black); overflow: clip; }
  .eyebrow { margin-block-end: 0.5rem; }
  .mega {
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    font-size: min(16.4vw, 27svh, 15rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: var(--coral-soft);
    margin-inline-start: -0.04em;
  }
  @supports (-webkit-background-clip: text) or (background-clip: text) {
    .mega { color: transparent; background: var(--fill) center 64% / 140% no-repeat; -webkit-background-clip: text; background-clip: text; -webkit-text-stroke: 1px rgb(255 255 255 / 0.28); }
  }
  .lead { margin-block: 0.5rem clamp(1rem, 3svh, 2.5rem); max-inline-size: none; }
  .mosaik { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); grid-auto-rows: clamp(8rem, 24svh, 16rem); }
  .tile { position: relative; overflow: clip; border-radius: var(--r3); background: #11161a; }
  .tile :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .tile:hover :global(img) { transform: scale(1.05); }
  .a { grid-column: span 2; }
  .sym { position: absolute; inset: auto 0.6rem 0.6rem auto; padding: 0.15rem 0.6rem; border-radius: 999px; background: rgb(3 5 4 / 0.72); font-size: 0.6875rem; letter-spacing: 0.04em; }
  .ph { display: grid; place-items: center; color: var(--text-muted); border: 1px dashed var(--border); }
  .circ { position: absolute; inline-size: 44%; aspect-ratio: 1; max-block-size: 80%; border-radius: 50%; background: rgb(217 33 41 / 0.22); }
  .ph .fehlt { position: relative; font-size: 0.75rem; white-space: normal; text-align: center; margin: 0.75rem; }
  @media (min-width: 52rem) {
    .mosaik { grid-template-columns: repeat(4, 1fr); }
    .a { grid-column: span 2; grid-row: span 2; }
  }
</style>
