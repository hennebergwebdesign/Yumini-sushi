---
import { Image } from 'astro:assets';
import { fotos, kategorien } from '../../lib/bilder';
// Nur Food Fotos vom Betreiber. Gäste, Team und Räume einer Filiale werden nie als Stockfoto gezeigt,
// sondern erst nach dem Fotoshooting (docs/plan.md, Abschnitt 12).
---
<section class="section paper" aria-labelledby="einblicke-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Einblicke</p>
      <h2 id="einblicke-title" class="h2">So sieht ein Abend bei Yumini aus.</h2>
    </div>

    <ul class="mosaik">
      <li class="tile a"><Image src={fotos.sushiPlatte} alt="Nigiri auf Schiefer mit Stäbchen" widths={[600, 1000, 1400]} sizes="(max-width: 52rem) 100vw, 50vw" /></li>
      <li class="tile b"><Image src={kategorien.dinner} alt="Nigiri Auswahl auf dunklem Teller" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /></li>
      <li class="tile c"><Image src={kategorien.grill} alt="Gegrilltes vom Teppangrill" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /></li>
      <li class="tile d ph"><span class="circ"></span><span class="fehlt">Foto: Gäste und Gastraum [[FEHLT]]</span></li>
      <li class="tile e"><Image src={kategorien.dessert} alt="Grüner Tee Eis in der Schale" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 25vw" /></li>
    </ul>
  </div>
</section>

<style>
  .head { display: grid; gap: 0.75rem; margin-block-end: 2.5rem; }
  .mosaik { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); grid-auto-rows: clamp(9rem, 28vw, 15rem); }
  .tile { position: relative; overflow: clip; border-radius: var(--r3); background: var(--black); }
  .tile :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .tile:hover :global(img) { transform: scale(1.05); }
  .a { grid-column: span 2; }
  .ph { display: grid; place-items: center; background: linear-gradient(160deg, #1b2420, #0a0f0d); color: var(--text-muted); }
  .circ { position: absolute; inline-size: 46%; aspect-ratio: 1; max-block-size: 80%; border-radius: 50%; background: radial-gradient(circle, rgb(217 33 41 / 0.5), rgb(217 33 41 / 0.08) 70%); }
  .ph .fehlt { position: relative; font-size: 0.75rem; white-space: normal; text-align: center; margin: 0.75rem; }
  @media (min-width: 52rem) {
    .mosaik { grid-template-columns: repeat(4, 1fr); }
    .a { grid-column: span 2; grid-row: span 2; }
  }
</style>
