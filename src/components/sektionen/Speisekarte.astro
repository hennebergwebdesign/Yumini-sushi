---
import Button from '../ui/Button.astro';
// Kategorien und Gerichte sind Beispiele bis zur Datei des Inhabers (offene Frage 11).
const kategorien = ['Sushi', 'Maki', 'Nigiri', 'Grill', 'Warme Gerichte', 'Desserts', 'Getränke'];
---
<section id="speisekarte" class="section slate" aria-labelledby="karte-title">
  <div class="wrap grid">
    <div class="mock" aria-hidden="true">
      <div class="book">
        <div class="page l">
          <i></i><i></i><i></i><i></i><i></i><i class="s"></i>
        </div>
        <div class="page r">
          <i></i><i></i><i></i><i></i><i></i><i class="s"></i>
        </div>
        <div class="spine"></div>
        <div class="cover">
          <span class="dot"></span>
          <b>Speisekarte</b>
          <small>Yumini<br />Japanese Sushi &amp; Grill</small>
        </div>
      </div>
    </div>

    <div class="copy">
      <p class="eyebrow">Speisekarte</p>
      <h2 id="karte-title" class="h2">Über 100 Speisen, eine Karte für alle Standorte.</h2>
      <p class="lead muted">Die Gerichte sind überall gleich, nur die Nummern am Tablet unterscheiden sich je Standort. Gerichte mit „Dinner Only“ gibt es nur abends.</p>

      <ul class="cats" aria-label="Beispielkategorien">
        {kategorien.map((k) => <li>{k}</li>)}
      </ul>

      <ul class="favs">
        {[1, 2, 3, 4].map((n) => (
          <li class="fav">
            <svg viewBox="0 0 100 100" aria-hidden="true"><use href={n % 2 ? '#maki' : '#nigiri'} width="100" height="100" /></svg>
            <span><span class="fehlt">[[FEHLT: Lieblingsgericht {n}]]</span></span>
          </li>
        ))}
      </ul>

      <div class="act">
        <Button href="/speisekarte/" variant="primary">Speisekarte ansehen</Button>
        <Button href="/speisekarte/blaettern/" variant="outline">Karte durchblättern</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .slate {
    background: #161c1d;
    overflow: clip;
  }
  .grid {
    display: grid;
    gap: 4rem;
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cats li {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.9375rem;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .cats li:hover {
    border-color: var(--coral-soft);
    background: rgb(255 255 255 / 0.05);
  }
  .favs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    inline-size: 100%;
  }
  .fav {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--r3);
    background: rgb(255 255 255 / 0.03);
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .fav:hover {
    transform: translateY(-3px);
    border-color: var(--coral-soft);
  }
  .fav svg {
    inline-size: 3rem;
  }
  .fav .fehlt {
    white-space: normal;
    font-size: 0.7rem;
  }
  .act {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Mockup: aufgeschlagene Karte, darauf schräg die Titelseite (Prinzip wie im Lumexx Katalog Mockup, neu gezeichnet) */
  .mock {
    display: grid;
    place-items: center;
    perspective: 1400px;
  }
  .book {
    position: relative;
    inline-size: min(100%, 34rem);
    aspect-ratio: 1.45;
    display: grid;
    grid-template-columns: 1fr 1fr;
    transform: rotateX(8deg);
    filter: drop-shadow(0 40px 40px rgb(0 0 0 / 0.5));
  }
  .page {
    display: grid;
    align-content: center;
    gap: 0.7rem;
    padding: 12% 11%;
    background: var(--paper);
  }
  .page.l {
    border-radius: 6px 0 0 6px;
    background: linear-gradient(90deg, #f5f1ec 85%, #ddd5c9);
  }
  .page.r {
    border-radius: 0 6px 6px 0;
    background: linear-gradient(270deg, #f5f1ec 85%, #ddd5c9);
  }
  .page i {
    display: block;
    block-size: 0.55rem;
    border-radius: 2px;
    background: #cfc7ba;
  }
  .page i.s {
    inline-size: 55%;
  }
  .page i:nth-child(odd) {
    inline-size: 80%;
  }
  .spine {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    inline-size: 3px;
    translate: -50% 0;
    background: rgb(0 0 0 / 0.25);
  }
  .cover {
    position: absolute;
    inset-block-start: 8%;
    inset-inline-start: 22%;
    inline-size: 46%;
    aspect-ratio: 0.72;
    display: grid;
    align-content: space-between;
    padding: 1.4rem 1.2rem;
    border-radius: 6px;
    background: var(--black);
    border: 1px solid #2a3530;
    rotate: -7deg;
    box-shadow: 0 20px 30px -10px rgb(0 0 0 / 0.6);
    transition: rotate 0.5s var(--ease), translate 0.5s var(--ease);
  }
  .mock:hover .cover {
    rotate: -3deg;
    translate: 0 -6px;
  }
  .cover .dot {
    inline-size: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand-red);
    justify-self: center;
    margin-block-start: 0.5rem;
  }
  .cover b {
    font-weight: 500;
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    text-align: center;
  }
  .cover small {
    font-size: 0.7rem;
    font-weight: 300;
    text-align: center;
    line-height: 1.3;
    color: var(--text-muted);
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
</style>
