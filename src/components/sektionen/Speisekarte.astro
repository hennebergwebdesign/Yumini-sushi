---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { gerichte, type GerichtId } from '../../lib/bilder';

// Namen und Beschreibungen aus den Speisekarten der Bestandsseite (Infopaket 20.10.2026).
const favoriten: { id: GerichtId; name: string; text: string; abends?: boolean }[] = [
  { id: 'sake', name: 'Sake', text: 'Lachs' },
  { id: 'maguro', name: 'Maguro', text: 'Thunfisch' },
  { id: 'ebi', name: 'Ebi', text: 'Garnelen' },
  { id: 'unagi', name: 'Unagi', text: 'Aal gegrillt', abends: true },
  { id: 'tempura-california', name: 'Tempura California Maki', text: 'Avocado und Surimi' },
  { id: 'ikura', name: 'Ikura', text: 'Lachskaviar', abends: true },
];
---
<section id="speisekarte" class="section slate" aria-labelledby="karte-title">
  <div class="wrap">
    <div class="head">
      <div class="txt">
        <p class="eyebrow">Speisekarte</p>
        <h2 id="karte-title" class="h2">Über 100 Speisen. Sie bestellen, wir bringen.</h2>
        <p class="lead muted">Sushi, Nigiri, Maki, Teppanyaki, warme Gerichte, Suppen und Salate. Gerichte mit „Dinner Only“ gibt es nur abends.</p>
      </div>

      <div class="mock" aria-hidden="true">
        <div class="book">
          <div class="page l"><i></i><i></i><i></i><i></i><i></i><i class="s"></i></div>
          <div class="page r"><i></i><i></i><i></i><i></i><i></i><i class="s"></i></div>
          <div class="spine"></div>
          <div class="cover">
            <img src="/images/logo.svg" alt="" width="200" height="70" />
            <b>Speisekarte</b>
            <small>Platzhalter, die gedruckte Karte folgt</small>
          </div>
        </div>
      </div>
    </div>

    <ul class="favs">
      {favoriten.map((f) => (
        <li class="fav">
          <div class="pic">
            <span class="halo" aria-hidden="true"></span>
            <Image src={gerichte[f.id]} alt={`${f.name}, ${f.text}`} widths={[260, 520]} sizes="(max-width: 40rem) 45vw, 22rem" />
          </div>
          <h3>{f.name}</h3>
          <p class="muted">{f.text}</p>
          {f.abends && <span class="tag">Dinner Only</span>}
        </li>
      ))}
    </ul>

    <div class="act">
      <Button href="/speisekarte/" variant="primary">Speisekarte ansehen</Button>
      <Button href="/speisekarte/blaettern/" variant="outline">Karte durchblättern</Button>
    </div>
  </div>
</section>

<style>
  .slate { background: #11161a; overflow: clip; }
  .head { display: grid; gap: 3rem; align-items: center; margin-block-end: clamp(2.5rem, 5vw, 4rem); }
  .txt { display: grid; gap: 1rem; max-inline-size: 36rem; }
  .mock { display: grid; place-items: center; perspective: 1400px; }
  .book { position: relative; inline-size: min(100%, 32rem); aspect-ratio: 1.45; display: grid; grid-template-columns: 1fr 1fr; transform: rotateX(8deg); filter: drop-shadow(0 40px 40px rgb(0 0 0 / 0.5)); }
  .page { display: grid; align-content: center; gap: 0.7rem; padding: 12% 11%; }
  .page.l { border-radius: 6px 0 0 6px; background: #f5f1ec; border-inline-end: 2px solid #ddd5c9; }
  .page.r { border-radius: 0 6px 6px 0; background: #f5f1ec; border-inline-start: 2px solid #ddd5c9; }
  .page i { display: block; block-size: 0.55rem; border-radius: 2px; background: #cfc7ba; }
  .page i:nth-child(odd) { inline-size: 80%; }
  .page i.s { inline-size: 55%; }
  .spine { position: absolute; inset-block: 0; inset-inline-start: 50%; inline-size: 3px; translate: -50% 0; background: rgb(0 0 0 / 0.25); }
  .cover {
    position: absolute; inset-block-start: 8%; inset-inline-start: 24%; inline-size: 46%; aspect-ratio: 0.72;
    display: grid; align-content: space-between; justify-items: center; padding: 1.4rem 1rem;
    border-radius: 6px; background: var(--black); border: 1px solid #2a3530; rotate: -7deg;
    box-shadow: 0 20px 30px -10px rgb(0 0 0 / 0.6); transition: rotate 0.5s var(--ease), translate 0.5s var(--ease);
  }
  .cover img { inline-size: 80%; block-size: auto; }
  .mock:hover .cover { rotate: -3deg; translate: 0 -6px; }
  .cover b { font-weight: 500; font-size: clamp(1rem, 2.2vw, 1.4rem); }
  .cover small { font-size: 0.6rem; font-weight: 300; text-align: center; color: var(--text-muted); }
  .favs {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .fav {
    position: relative;
    display: grid;
    gap: 0.25rem;
    justify-items: start;
    padding: 1rem 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--r3);
    background: rgb(255 255 255 / 0.03);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .fav:hover { transform: translateY(-6px); border-color: var(--coral-soft); background: rgb(255 255 255 / 0.06); }
  .pic { position: relative; display: grid; place-items: center; inline-size: 100%; aspect-ratio: 4 / 3; margin-block-end: 0.5rem; }
  .pic :global(img) {
    position: relative;
    inline-size: 86%;
    block-size: auto;
    max-block-size: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 16px rgb(0 0 0 / 0.55));
    transition: transform 0.5s var(--ease);
  }
  .fav:hover .pic :global(img) { transform: scale(1.1) rotate(-3deg); }
  .halo {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: rgb(217 33 41 / 0.22);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .fav:hover .halo { opacity: 1; }
  h3 { font-size: 1.1875rem; }
  .tag {
    margin-block-start: 0.35rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--coral-soft);
    color: var(--coral-soft);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .act { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 62rem) { .head { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  @media (min-width: 52rem) { .favs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .favs { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
