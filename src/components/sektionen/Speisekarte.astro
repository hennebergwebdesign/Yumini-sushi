---
import Button from '../ui/Button.astro';
import KatalogMockup from '../ui/KatalogMockup.astro';
import { karte, bildUrl } from '../../lib/speisekarte';

// Beliebte Gerichte, Namen und Beschreibungen aus der Karte Bochum (Infopaket 20.10.2026)
const namen = ['Sake', 'Maguro', 'Ebi', 'Unagi', 'Sake Aburi', 'Ikura', 'Tekka Maki', 'Tempura California Maki', 'Yaki Tori', 'Ebi Tempura', 'Gyoza', 'Grüner Tee Eis'];
const bochum = karte('bochum');
const favoriten = namen.map((n) => bochum.find((g) => g.name === n)).filter((g): g is NonNullable<typeof g> => !!g && !!g.bild);
---
<section id="speisekarte" class="section slate" aria-labelledby="karte-title">
  <div class="wrap">
    <div class="head">
      <div class="txt">
        <p class="eyebrow">Speisekarte</p>
        <h2 id="karte-title" class="h2">Über 100 Speisen mit Foto.</h2>
        <p class="lead muted">Sushi, Nigiri, Maki, Teppanyaki, warme Gerichte, Suppen und Salate. Gerichte mit „Dinner Only“ gibt es nur abends.</p>
      </div>

      <div class="mock"><KatalogMockup /></div>
    </div>

    <ul class="favs">
      {favoriten.map((f) => (
        <li class="fav">
          <div class="pic">
            <span class="halo" aria-hidden="true"></span>
            <img src={bildUrl(f)!} alt={`${f.name}, ${f.desc}`} width="420" height="420" loading="lazy" decoding="async" />
          </div>
          <h3>{f.name}</h3>
          <p class="muted">{f.desc}</p>
          {f.abends && <span class="tag">Dinner Only</span>}
        </li>
      ))}
    </ul>

    <div class="act">
      <Button href="/speisekarte/" variant="primary">Alle Gerichte mit Foto ansehen</Button>
      <Button href="/speisekarte/blaettern/" variant="outline">Karte durchblättern</Button>
    </div>
  </div>
</section>

<style>
  .slate { background: #11161a; overflow: clip; }
  .head { display: grid; gap: 3rem; align-items: center; margin-block-end: clamp(2.5rem, 5vw, 4rem); }
  .txt { display: grid; gap: 1rem; max-inline-size: 36rem; }
  .mock { display: grid; place-items: center; }
  .favs {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .fav {
    position: relative;
    display: grid;
    gap: 0.25rem;
    justify-items: start;
    padding: 1rem 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--r3);
    background: rgb(255 255 255 / 0.03);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .fav:hover { transform: translateY(-6px); border-color: var(--coral-soft); background: rgb(255 255 255 / 0.06); }
  .pic { position: relative; display: grid; place-items: center; inline-size: 100%; aspect-ratio: 4 / 3; margin-block-end: 0.5rem; }
  .pic :global(img) {
    position: relative;
    inline-size: 86%;
    block-size: auto;
    max-block-size: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 16px rgb(0 0 0 / 0.55));
    transition: transform 0.5s var(--ease);
  }
  .fav:hover .pic :global(img) { transform: scale(1.1) rotate(-3deg); }
  .halo {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: rgb(217 33 41 / 0.22);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .fav:hover .halo { opacity: 1; }
  h3 { font-size: 1.1875rem; }
  .tag {
    margin-block-start: 0.35rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--coral-soft);
    color: var(--coral-soft);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .act { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 62rem) { .head { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  @media (min-width: 52rem) { .favs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .favs { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
