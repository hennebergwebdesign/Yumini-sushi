---
import ReservierungsTool from '../ReservierungsTool.astro';
---
<section id="reservieren" class="section paper" aria-labelledby="res-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Online reservieren</p>
      <h2 id="res-title" class="h2">Ihr Tisch in unter einer Minute.</h2>
      <p class="lead muted">Standort, Datum, Personen und Uhrzeit wählen. Sie sehen sofort, welche Zeiten noch frei sind, und bekommen die Bestätigung per Mail.</p>
    </div>

    <div class="device">
      <div class="tablet">
        <span class="cam" aria-hidden="true"></span>
        <div class="screen">
          <ReservierungsTool uid="t" />
        </div>
      </div>
      <div class="shadow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
    max-inline-size: 44rem;
  }
  .device {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .tablet {
    position: relative;
    inline-size: min(100%, 62rem);
    padding: clamp(0.9rem, 2vw, 1.6rem);
    border-radius: clamp(1.25rem, 3vw, 2.25rem);
    background: linear-gradient(145deg, #1d2420, #070a09);
    box-shadow:
      0 0 0 1.5px #313b36,
      0 40px 80px -30px rgb(17 21 19 / 0.55);
  }
  .cam {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.55rem;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: #0e1311;
    box-shadow: inset 0 0 0 1px #3a4540;
  }
  .screen {
    border-radius: clamp(0.5rem, 1.2vw, 0.9rem);
    background: var(--black);
    padding: clamp(1rem, 2.6vw, 2rem);
  }
  .shadow {
    inline-size: 60%;
    block-size: 1.5rem;
    margin-block-start: -0.5rem;
    background: radial-gradient(closest-side, rgb(17 21 19 / 0.25), transparent);
    filter: blur(4px);
  }

  /* Auf dem Handy fällt der Rahmen weg, das Tool nimmt die volle Breite */
  @media (max-width: 52rem) {
    .tablet {
      padding: 0;
      background: none;
      box-shadow: none;
    }
    .cam,
    .shadow {
      display: none;
    }
    .screen {
      border-radius: var(--r4);
      padding: 1.25rem;
    }
  }
</style>
