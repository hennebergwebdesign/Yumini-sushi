---
import { Image } from 'astro:assets';
import { raeume, standortFotos, type RaumId } from '../../lib/bilder';
import type { Standort } from '../../lib/standorte';
// Echte Fotos des Standorts zuerst (aus standortFotos in bilder.ts). Fehlende Plätze füllen Symbolbilder
// japanischer Restaurants, KEINE Aufnahmen aus Yumini, im Bild als Symbolbild beschriftet.
interface Props { s: Standort }
const { s } = Astro.props;
const reihen: Record<Standort['id'], RaumId[]> = {
  bochum: ['halle', 'laternen', 'theke'],
  dortmund: ['laternen', 'theke', 'halle'],
  gelsenkirchen: ['theke', 'halle', 'gasse'],
  luedenscheid: ['gasse', 'laternen', 'halle'],
  siegen: ['halle', 'gasse', 'theke'],
};
type Bild = { src: ImageMetadata; alt: string; symbol: boolean };
const echte: Bild[] = (standortFotos[s.id] ?? []).map((f) => ({ ...f, symbol: false }));
const symbole: Bild[] = reihen[s.id].map((id) => ({ src: raeume[id].src, alt: raeume[id].alt, symbol: true }));
const [a, b, c] = [...echte, ...symbole].slice(0, 3);
const titel = (x: Bild) => (x.symbol ? 'Symbolbild Gastraum' : `Yumini ${s.name}`);
---
<section class="lokal" aria-labelledby="lokal-title">
  <div class="wrap">
    <div class="kopf">
      <div>
        <p class="eyebrow">Im Lokal</p>
        <h2 id="lokal-title" class="h2">Ein Abend bei Yumini {s.name}</h2>
      </div>
      {/* [[FEHLT: weitere Aufnahmen aus dem Lokal je Standort]] */}
    </div>
    <ul class="bilder">
      <li class="gross"><Image src={a.src} alt={a.alt} title={titel(a)} widths={[700, 1100, 1600]} quality={72} sizes="(max-width: 52rem) 100vw, 60vw" />{a.symbol && <span class="sym">Symbolbild</span>}</li>
      <li><Image src={b.src} alt={b.alt} title={titel(b)} widths={[500, 900]} sizes="(max-width: 52rem) 50vw, 20vw" />{b.symbol && <span class="sym">Symbolbild</span>}</li>
      <li><Image src={c.src} alt={c.alt} title={titel(c)} widths={[500, 900]} sizes="(max-width: 52rem) 50vw, 20vw" />{c.symbol && <span class="sym">Symbolbild</span>}</li>
    </ul>
  </div>
</section>

<style>
  .lokal { padding-block: var(--space-section); background: #0a0d0c; }
  .kopf { display: flex; flex-wrap: wrap; gap: 1rem 3rem; align-items: end; justify-content: space-between; margin-block-end: 2rem; }
  .bilder { display: grid; gap: 0.75rem; grid-template-columns: 1fr 1fr; grid-auto-rows: clamp(9rem, 30vw, 14rem); }
  .bilder li { position: relative; overflow: clip; border-radius: var(--r3); background: #11161a; }
  .bilder li :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .bilder li:hover :global(img) { transform: scale(1.05); }
  .gross { grid-column: 1 / -1; grid-row: span 2; }
  .sym { position: absolute; inset: auto 0.75rem 0.75rem auto; padding: 0.15rem 0.6rem; border-radius: 999px; background: rgb(3 5 4 / 0.72); font-size: 0.6875rem; letter-spacing: 0.04em; }
  @media (min-width: 52rem) {
    .bilder { grid-template-columns: 1.5fr 1fr; grid-auto-rows: clamp(10rem, 18vw, 15rem); }
    .gross { grid-column: 1; grid-row: 1 / span 2; }
  }
</style>
