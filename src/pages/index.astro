---
import Base from '../layouts/Base.astro';
import Hero from '../components/sektionen/Hero.astro';
import Preise from '../components/sektionen/Preise.astro';
import Ablauf from '../components/sektionen/Ablauf.astro';
import Standorte from '../components/sektionen/Standorte.astro';
import Reservierung from '../components/sektionen/Reservierung.astro';
import Speisekarte from '../components/sektionen/Speisekarte.astro';
import Auswahl from '../components/sektionen/Auswahl.astro';
import Feiern from '../components/sektionen/Feiern.astro';
import Einblicke from '../components/sektionen/Einblicke.astro';
import Bewertungen from '../components/sektionen/Bewertungen.astro';
import KarriereBand from '../components/sektionen/KarriereBand.astro';
import Fragen from '../components/sektionen/Fragen.astro';
import Abschluss from '../components/sektionen/Abschluss.astro';
import { standorte } from '../lib/standorte';
import { restaurantLd, organisationLd, faqLd, websiteLd } from '../lib/seo';
import { fragen } from '../lib/faq';
---
<Base
  title="Sushi All you can eat in NRW | Yumini Sushi & Grill"
  description="All you can eat Sushi & Grill in Bochum, Dortmund, Gelsenkirchen, Lüdenscheid und Siegen: über 100 Speisen per Tablet. Jetzt Tisch online reservieren."
  pfad="/"
  ld={[websiteLd, organisationLd, ...standorte.map(restaurantLd), faqLd(fragen)]}
>
  <Hero />
  <Reservierung />
  <Ablauf />
  <Speisekarte />
  <Auswahl />
  <Preise />
  <Standorte />
  <Feiern />
  <Einblicke />
  <Bewertungen />
  <KarriereBand />
  <Fragen />
  <Abschluss />
</Base>
