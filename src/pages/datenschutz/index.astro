---
import Base from '../../layouts/Base.astro';
---
<Base title="Datenschutz | Yumini Japanese Sushi & Grill" description="Datenschutz von Yumini Japanese Sushi & Grill." pfad="/datenschutz/" noindex mobilLeiste={false}>
  <section class="legal" aria-labelledby="l-title">
    <div class="wrap">
      <h1 id="l-title" class="display">Datenschutz</h1>
      <p><span class="fehlt">[[FEHLT: Rechtstext vom Inhaber]]</span></p>
      <p><a href="/">Zurück zur Startseite</a></p>
    </div>
  </section>
</Base>

<style>
  .legal { min-block-size: 70svh; padding-block: 8rem 4rem; }
  .wrap { display: grid; gap: 1.25rem; justify-items: start; }
</style>
