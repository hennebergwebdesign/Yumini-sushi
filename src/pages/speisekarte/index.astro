---
import Base from '../../layouts/Base.astro';
import { standorte } from '../../lib/standorte';
import { karte, kategorien, bildUrl } from '../../lib/speisekarte';
import { SITE } from '../../lib/config';
import { breadcrumbLd } from '../../lib/seo';

// Eine Seite für alle Standorte (Wunsch des Inhabers, 21.10.2026): oben der Standortfilter, darunter
// „So bestellen Sie“, dann Kategorien und Gerichte. Die Karten unterscheiden sich je Standort in Nummern
// und einzelnen Gerichten, deshalb steht für jeden Standort ein eigenes Raster im HTML. Umgeschaltet wird
// mit reinem CSS über die Radiofelder, ein kleines Skript setzt nur ?ort= in der Adresse.
// Bilder laden verzögert, ausgeblendete Raster laden also keine Fotos.
const orte = standorte.map((s) => {
  const alle = karte(s.id);
  return {
    s,
    alle,
    abends: alle.filter((g) => g.abends).length,
    anzahl: (k: string) => alle.filter((g) => g.kat === k).length,
  };
});
const kats = kategorien.filter((k) => orte.some((o) => o.anzahl(k.id) > 0));
const filter = [
  { id: 'alle', label: 'Alle', n: (o: (typeof orte)[number]) => o.alle.length },
  { id: 'dinner', label: 'Dinner Only', n: (o: (typeof orte)[number]) => o.abends },
  ...kats.map((k) => ({ id: k.id, label: k.label, n: (o: (typeof orte)[number]) => o.anzahl(k.id) })),
];
const menuLd = orte.map(({ s, alle, anzahl }) => ({
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Speisekarte Yumini ${s.name}`,
  url: `${SITE}/speisekarte/?ort=${s.id}`,
  inLanguage: 'de',
  hasMenuSection: kategorien
    .filter((k) => anzahl(k.id) > 0)
    .map((k) => ({
      '@type': 'MenuSection',
      name: k.label,
      hasMenuItem: alle.filter((g) => g.kat === k.id).map((g) => ({ '@type': 'MenuItem', name: g.name, description: g.desc || undefined })),
    })),
}));
const ortsnamen = standorte.map((s) => s.name);
---
<Base
  title="Sushi Speisekarte mit Fotos | Yumini Sushi & Grill"
  description="Die Speisekarte von Yumini mit über 100 Gerichten und Fotos: Sushi, Teppanyaki, Suppen, Salate und Dessert. Für Bochum, Dortmund, Gelsenkirchen, Lüdenscheid und Siegen."
  pfad="/speisekarte/"
  keywords={['Sushi Speisekarte', 'Yumini Speisekarte', 'Speisekarte mit Fotos', 'All you can eat Speisekarte', 'Sushi Gerichte', 'Teppanyaki', 'Dinner Only', ...ortsnamen.map((n) => `Speisekarte ${n}`)]}
  ld={[...menuLd, breadcrumbLd([{ name: 'Yumini', pfad: '/' }, { name: 'Speisekarte', pfad: '/speisekarte/' }])]}
>
  <div class="sk">
    <section class="kopf" aria-labelledby="sk-title">
      <div class="wrap">
        <p class="eyebrow">Speisekarte</p>
        <h1 id="sk-title" class="display">Die ganze Karte<br />mit Fotos</h1>
        <p class="lead">Über 100 warme und kalte Speisen, Suppen, Salate, Sushi und Teppanyaki. Nummern und einzelne Gerichte unterscheiden sich je Standort.</p>

        <fieldset class="orte">
          <legend>Ihr Standort</legend>
          <div class="ortwahl">
            {standorte.map((s, i) => (
              <>
                <input class="vh" type="radio" name="ort" id={`o-${s.id}`} value={s.id} checked={i === 0} />
                <label for={`o-${s.id}`}>{s.name}</label>
              </>
            ))}
          </div>
        </fieldset>
        <script is:inline>
          (function () {
            var o = new URLSearchParams(location.search).get('ort');
            var r = o && document.getElementById('o-' + o);
            if (r) r.checked = true;
          })();
        </script>
        <p class="ortinfo" aria-live="polite">
          {orte.map(({ s, alle, abends }) => (
            <span data-o={s.id}><b>Yumini {s.name}:</b> {alle.length} Gerichte, davon {abends} nur abends. Zeit am Tisch {s.dauer}. Die Nummern gelten für das Tablet in {s.name}.</span>
          ))}
        </p>
      </div>
    </section>

    <section class="regeln" aria-labelledby="regeln-title">
      <div class="wrap grid2">
        <div>
          <h2 id="regeln-title" class="h2">So bestellen Sie</h2>
          <p class="muted">Sie bestellen per Tablet in mehreren Runden. Pro Runde und Person bis zu 6 Speisen mittags und 5 Speisen abends. Gerichte mit „Dinner Only“ gibt es nur abends.</p>
        </div>
        <p class="muted">Bitte bestellen Sie nur so viel, wie Sie essen können. Für Reste berechnen wir 1,00 € je Stück Sushi und Salat und 2,00 € je warmes Gericht, der Erlös wird gespendet. Getränke sind nicht inklusive.</p>
      </div>
    </section>

    <section class="karte" aria-labelledby="karte-title">
      <h2 id="karte-title" class="vh">Gerichte</h2>
      <div class="wrap">
        <div class="werkzeuge">
          <div class="filter" role="radiogroup" aria-label="Kategorie">
            {filter.map((f, i) => (
              <>
                <input class="vh" type="radio" name="f" id={`f-${f.id}`} checked={i === 0} />
                <label for={`f-${f.id}`}>{f.label}<small>{orte.map((o) => <span data-o={o.s.id}>{f.n(o)}</span>)}</small></label>
              </>
            ))}
          </div>
          <label class="schalter">
            <input class="vh" type="checkbox" id="preise" />
            <span class="sw" aria-hidden="true"></span>
            Außer Haus, Preise anzeigen
          </label>
        </div>

        {orte.map(({ s, alle }) => (
          <ul class="grid" data-o={s.id} aria-label={`Gerichte in ${s.name}`}>
            {alle.map((g) => {
              const u = bildUrl(g);
              return (
                <li class="card" data-kat={g.kat} data-d={g.abends ? '1' : '0'}>
                  <div class="pic">
                    {u ? <img src={u} alt={`${g.name}${g.desc ? `, ${g.desc}` : ''} bei Yumini ${s.name}`} title={g.name} width="420" height="420" loading="lazy" decoding="async" /> : <span class="leer" aria-hidden="true"></span>}
                    <span class="nr">{g.nr}</span>
                    {g.abends && <span class="tag">Dinner Only</span>}
                  </div>
                  <h3>{g.name}</h3>
                  {g.desc && <p class="desc">{g.desc}</p>}
                  <p class="preis">{g.preis.replace('.', ',')} €</p>
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  // Gewählten Standort in die Adresse schreiben, damit Links und Teilen den Standort behalten
  document.querySelectorAll<HTMLInputElement>('input[name="ort"]').forEach((r) =>
    r.addEventListener('change', () => {
      const u = new URL(location.href);
      u.searchParams.set('ort', r.value);
      history.replaceState(null, '', u);
    }),
  );
</script>

<style>
  .kopf { padding-block: calc(var(--kopf) + 2rem) 2.5rem; background: var(--black); }
  .kopf h1 { font-size: clamp(2.6rem, 7vw, 5.5rem); margin-block: 0.6rem 1.2rem; }

  /* Standortfilter */
  .orte { margin-block-start: 2rem; padding: 0; border: 0; min-inline-size: 0; }
  .orte legend { padding: 0; margin-block-end: 0.75rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .ortwahl { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ortwahl label {
    display: grid;
    place-items: center;
    min-block-size: 3rem;
    padding-inline: 1.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .ortwahl label:hover { border-color: var(--text); }
  .ortwahl input:checked + label { background: var(--text); color: var(--black); border-color: var(--text); }
  .ortwahl input:focus-visible + label { outline: 3px solid var(--coral-soft); outline-offset: 2px; }
  .ortinfo { margin-block-start: 1rem; color: var(--text-muted); font-size: 0.9375rem; }
  .ortinfo b { color: var(--text); font-weight: 500; }

  /* Nur der gewählte Standort ist sichtbar: Raster, Zählungen und Infozeile */
  .sk:has(#o-bochum:checked) [data-o]:not([data-o='bochum']),
  .sk:has(#o-dortmund:checked) [data-o]:not([data-o='dortmund']),
  .sk:has(#o-gelsenkirchen:checked) [data-o]:not([data-o='gelsenkirchen']),
  .sk:has(#o-luedenscheid:checked) [data-o]:not([data-o='luedenscheid']),
  .sk:has(#o-siegen:checked) [data-o]:not([data-o='siegen']) { display: none; }

  /* Kompakt, damit die Gerichte schnell folgen */
  .regeln { padding-block: clamp(1.75rem, 4vw, 2.5rem); background: #11161a; }
  .grid2 { display: grid; gap: 0.75rem 4rem; }
  .grid2 .h2 { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem); margin-block-end: 0.6rem; }
  @media (min-width: 62rem) { .grid2 { grid-template-columns: 1fr 1fr; align-items: end; } }

  .karte { padding-block: 1.5rem 5rem; background: var(--black); }
  .werkzeuge { position: sticky; inset-block-start: 4.75rem; z-index: 20; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; justify-content: space-between; align-items: center; padding-block: 0.8rem; margin-block-end: 1rem; background: rgb(3 5 4 / 0.94); backdrop-filter: blur(8px); border-block-end: 1px solid var(--border); }
  /* Mobil sind Filter und Schalter vier Zeilen hoch: sticky würde den halben Bildschirm verdecken und die Karten darüber abschneiden */
  @media (max-width: 68rem) { .werkzeuge { position: static; background: none; backdrop-filter: none; border-block-end: 0; padding-block: 0; } }
  .filter { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .filter label { display: inline-flex; align-items: center; gap: 0.45rem; min-block-size: 2.4rem; padding-inline: 0.95rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.9rem; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; }
  .filter label:hover { border-color: var(--text-muted); }
  .filter label small { color: var(--text-muted); font-size: 0.75rem; }
  .filter input:checked + label { background: var(--text); color: var(--black); border-color: var(--text); font-weight: 500; }
  .filter input:checked + label small { color: #4a524e; }
  .filter input:focus-visible + label, .schalter input:focus-visible ~ .sw { outline: 3px solid var(--coral-soft); outline-offset: 2px; }
  .schalter { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; cursor: pointer; }
  .sw { position: relative; inline-size: 2.6rem; block-size: 1.5rem; border-radius: 999px; border: 1px solid var(--border); background: #1a2123; transition: background-color 0.2s; }
  .sw::after { content: ''; position: absolute; inset-block-start: 2px; inset-inline-start: 2px; inline-size: 1.15rem; block-size: 1.15rem; border-radius: 50%; background: var(--text); transition: translate 0.25s var(--ease); }
  #preise:checked ~ .sw { background: var(--brand-red); border-color: var(--brand-red); }
  #preise:checked ~ .sw::after { translate: 1.1rem 0; }

  .grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { position: relative; display: grid; gap: 0.2rem; align-content: start; padding: 0.75rem 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--r3); background: #0a0d0c; transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease), transform 0.3s var(--ease); }
  .card:hover { border-color: var(--coral-soft); background: #11161a; transform: translateY(-4px); }
  .pic { position: relative; display: grid; place-items: center; aspect-ratio: 1; margin-block-end: 0.4rem; }
  .pic img { inline-size: 92%; block-size: auto; max-block-size: 92%; object-fit: contain; filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.55)); transition: transform 0.5s var(--ease); }
  .card:hover .pic img { transform: scale(1.08) rotate(-2deg); }
  .leer { inline-size: 46%; aspect-ratio: 1; border-radius: 50%; background: rgb(217 33 41 / 0.25); }
  .nr { position: absolute; inset-block-start: 0; inset-inline-start: 0; display: grid; place-items: center; min-inline-size: 1.9rem; block-size: 1.9rem; padding-inline: 0.45rem; border-radius: 999px; background: var(--brand-red); font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: 0.72rem; }
  .tag { position: absolute; inset-block-start: 0; inset-inline-end: 0; padding: 0.1rem 0.55rem; border-radius: 999px; border: 1px solid var(--coral-soft); background: rgb(3 5 4 / 0.85); color: var(--coral-soft); font-size: 0.68rem; font-weight: 500; }
  .card h3 { font-size: 1rem; font-weight: 500; letter-spacing: 0; line-height: 1.2; }
  .desc { color: var(--text-muted); font-size: 0.85rem; line-height: 1.35; }
  .preis { display: none; margin-block-start: 0.3rem; font-weight: 500; color: var(--coral-soft); }
  .werkzeuge:has(#preise:checked) ~ .grid .preis { display: block; }

  .werkzeuge:has(#f-dinner:checked) ~ .grid .card[data-d='0'],
  .werkzeuge:has(#f-sushi:checked) ~ .grid .card:not([data-kat='sushi']),
  .werkzeuge:has(#f-warm:checked) ~ .grid .card:not([data-kat='warm']),
  .werkzeuge:has(#f-beilagen:checked) ~ .grid .card:not([data-kat='beilagen']),
  .werkzeuge:has(#f-dessert:checked) ~ .grid .card:not([data-kat='dessert']),
  .werkzeuge:has(#f-saucen:checked) ~ .grid .card:not([data-kat='saucen']) { display: none; }

  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 62rem) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 80rem) { .grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
</style>
