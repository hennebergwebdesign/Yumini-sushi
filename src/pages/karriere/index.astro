---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Txt from '../../components/ui/Txt.astro';
import KarriereIcon from '../../components/ui/KarriereIcon.astro';
import { standorte } from '../../lib/standorte';
import { kategorien, raeume } from '../../lib/bilder';
import { bereiche, stellen, vorteile, tag, ablauf, fragen } from '../../lib/karriere';

const hg = (src: ImageMetadata) => getImage({ src, width: 1600, format: 'webp' }).then((b) => `--bg:url(${b.src})`);
const bg = {
  hero: await hg(kategorien.grill),
  vorteile: await hg(raeume.halle.src),
  team: await hg(raeume.gasse.src),
  bewerben: await hg(kategorien.sushi),
};

// Bild je Stelle. Raumbilder sind Symbolbilder von Unsplash, die Speisefotos stammen von yumini.de.
const stellenBild: Record<string, { src: ImageMetadata; alt: string; symbol?: boolean }> = {
  sushi: { src: kategorien.sushi, alt: 'Frisch zubereitete Sushi Platte' },
  kueche: { src: kategorien.dinner, alt: 'Warme Gerichte aus der Küche' },
  grill: { src: kategorien.grill, alt: 'Gegrilltes und Spieße' },
  service: { src: raeume.laternen.src, alt: raeume.laternen.alt, symbol: true },
  theke: { src: kategorien.dessert, alt: 'Desserts und Eis von der Theke' },
  aushilfe: { src: raeume.gasse.src, alt: raeume.gasse.alt, symbol: true },
};

// Das Team je Bereich. Bis zum Shooting steht hier das Speisefoto des Bereichs, bewusst kein Stockfoto von Personen.
const team = [
  { bereich: 'Sushi', bild: kategorien.sushi, alt: 'Sushi Station' },
  { bereich: 'Küche', bild: kategorien.dinner, alt: 'Warme Küche' },
  { bereich: 'Grill', bild: kategorien.grill, alt: 'Grill und Teppanyaki' },
  { bereich: 'Service', bild: kategorien.dessert, alt: 'Service und Theke' },
];

const erfahrung = [
  { id: 'keine', t: 'Keine', x: 'Ich fange neu an' },
  { id: 'wenig', t: 'Bis 1 Jahr', x: 'Erste Erfahrung' },
  { id: 'viel', t: 'Mehr als 1 Jahr', x: 'Ich kenne den Alltag' },
];
const eintritt = [
  { id: 'sofort', t: 'Sofort', x: 'Ich kann direkt starten' },
  { id: 'bald', t: 'In 1 bis 3 Monaten', x: 'Nach Absprache' },
  { id: 'spaeter', t: 'Später', x: 'Ich orientiere mich' },
];
---
<Base
  title="Karriere bei Yumini | Jobs in Küche, Sushi, Grill und Service"
  description="Jobs bei Yumini in Bochum, Dortmund, Gelsenkirchen, Lüdenscheid und Siegen: Sushi, Küche, Grill, Service, Theke und Aushilfe. In 2 Minuten bewerben, ohne Lebenslauf."
  pfad="/karriere/"
  mobilLeiste={false}
  autoReveal={false}
>
  <div class="fortschritt" aria-hidden="true"></div>
  <section class="hero bgs" style={bg.hero} aria-labelledby="k-title">
    <!-- Platz für das Video: <video class="hvideo" autoplay muted loop playsinline poster=... src=...></video> als erstes Kind der Section, das Standbild dient als Poster -->
    <p class="vhint"><span class="fehlt">[[FEHLT: Video, Arbeiten bei Yumini]]</span></p>
    <div class="wrap hgrid">
      <div class="copy">
        <p class="eyebrow">Karriere bei Yumini</p>
        <h1 id="k-title" class="display big"><span>Dein Platz</span><span>im Team.</span></h1>
        <p class="lead">Wir suchen Verstärkung für Sushi, Küche, Grill, Service und Theke an allen fünf Standorten. Bewirb dich in zwei Minuten, ohne Lebenslauf.</p>
        <div class="actions">
          <Button href="#bewerben" variant="primary" size="lg">In 2 Minuten bewerben</Button>
          <Button href="#stellen" variant="outline" size="lg">Offene Stellen</Button>
        </div>
      </div>
      <ul class="facts" aria-label="Yumini in Zahlen">
        <li class="glass"><b data-count="5">5</b><span>Standorte in NRW</span></li>
        <li class="glass"><b data-count="6">6</b><span>Bereiche zur Auswahl</span></li>
        <li class="glass"><b data-count="0">0</b><span>Lebenslauf nötig</span></li>
      </ul>
    </div>
  </section>

  <section id="stellen" class="sec dark" aria-labelledby="s-title">
    <div class="wrap">
      <div class="shead rv">
        <p class="eyebrow">Offene Stellen</p>
        <h2 id="s-title" class="h2">Das suchen wir.</h2>
        <p class="lead muted">Entwurf: Welche Stellen an welchem Standort offen sind, bestätigt der Inhaber <span class="fehlt">[[FEHLT: Bedarf je Standort]]</span>.</p>
      </div>
      <div class="jobs">
        {stellen.map((j, i) => {
          const b = stellenBild[j.bereich];
          return (
            <details class="job glass rv" name="stelle" open={i === 0}>
              <summary>
                <figure class="jimg">
                  <Image src={b.src} alt={b.alt} widths={[360, 640]} sizes="(max-width: 52rem) 100vw, 20rem" />
                  {b.symbol && <figcaption>Symbolbild</figcaption>}
                </figure>
                <span class="jt">
                  <span class="chips"><span class="chip">{j.art}</span><span class="chip">Alle Standorte</span></span>
                  <b>{j.titel}</b>
                  <small>{j.kurz}</small>
                </span>
                <span class="mehr" aria-hidden="true"><span class="zu">Details</span><span class="auf">Schließen</span><i></i></span>
              </summary>
              <div class="jb">
                <div class="cols">
                  <div><h4>Deine Aufgaben</h4><ul>{j.aufgaben.map((a) => <li><Txt t={a} /></li>)}</ul></div>
                  <div><h4>Das bringst du mit</h4><ul>{j.profil.map((a) => <li><Txt t={a} /></li>)}</ul></div>
                  <div><h4>Das bieten wir</h4><ul>{j.bieten.map((a) => <li><Txt t={a} /></li>)}</ul></div>
                </div>
                <a class="btn-job" href="#bewerben" data-bereich={j.bereich}>Auf diese Stelle bewerben</a>
              </div>
            </details>
          );
        })}
      </div>
      <div class="cta glass rv">
        <p><b>Nichts Passendes dabei?</b> Bewirb dich trotzdem, wir finden den richtigen Platz für dich.</p>
        <Button href="#bewerben" variant="primary">Jetzt bewerben</Button>
      </div>
    </div>
  </section>

  <section class="sec bgs" style={bg.vorteile} aria-labelledby="v-title">
    <div class="wrap">
      <div class="shead rv">
        <p class="eyebrow">Das bekommst du</p>
        <h2 id="v-title" class="h2">Warum Yumini.</h2>
        <p class="lead muted">Entwurf: Zusagen stehen erst nach Bestätigung durch den Inhaber fest.</p>
      </div>
      <ul class="vgrid">
        {vorteile.map((v) => (
          <li class="vcard glass rv">
            <span class="ico"><KarriereIcon name={v.icon as any} /></span>
            <h3>{v.t}</h3>
            <p class="muted"><Txt t={v.x} /></p>
          </li>
        ))}
      </ul>
      <div class="cta glass rv">
        <p><b>Klingt gut?</b> Zwei Minuten, vier Klicks, kein Lebenslauf.</p>
        <Button href="#bewerben" variant="primary">In 2 Minuten bewerben</Button>
      </div>
    </div>
  </section>

  <section class="tagsec" aria-labelledby="t-title">
    <div class="wrap tg">
      <div class="shead rv">
        <p class="eyebrow">Ein Abend bei Yumini</p>
        <h2 id="t-title" class="h2">So sieht dein Dienst aus.</h2>
        <p class="lead muted">Beispielablauf eines Abenddienstes, Zeiten je Standort <span class="fehlt">[[FEHLT: bestätigen]]</span>.</p>
        <figure class="sym">
          <Image src={raeume.theke.src} alt={raeume.theke.alt} widths={[500, 900]} sizes="(max-width: 62rem) 100vw, 28rem" />
          <figcaption>Symbolbild, kein Foto aus Yumini</figcaption>
        </figure>
      </div>
      <ol class="zeit">
        {tag.map((z) => (
          <li class="rv"><time>{z.zeit}</time><div><h3>{z.t}</h3><p class="muted"><Txt t={z.x} /></p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec bgs" style={bg.team} aria-labelledby="tm-title">
    <div class="wrap">
      <div class="shead rv">
        <p class="eyebrow">Das Team</p>
        <h2 id="tm-title" class="h2">Die Menschen dahinter.</h2>
        <p class="lead muted">Echte Kolleginnen und Kollegen mit Namen zeigen wir, sobald wir sie fotografieren dürfen. Bis dahin steht hier das Bild des Bereichs, bewusst kein Stockfoto von Personen.</p>
      </div>
      <ul class="tiles">
        {team.map((m) => (
          <li class="tile glass rv">
            <figure>
              <Image src={m.bild} alt={m.alt} widths={[320, 560]} sizes="(max-width: 52rem) 50vw, 17rem" />
            </figure>
            <div class="tt">
              <b>{m.bereich}</b>
              <span class="fehlt">Name und Foto [[FEHLT]]</span>
            </div>
          </li>
        ))}
      </ul>
      <div class="cta glass rv">
        <p><b>Werde Teil davon.</b> Sag uns, wo du am liebsten arbeiten würdest.</p>
        <Button href="#bewerben" variant="primary">Jetzt bewerben</Button>
      </div>
    </div>
  </section>

  <section class="sec paper ablauf" aria-labelledby="a-title">
    <div class="wrap agrid">
      <div class="shead rv">
        <p class="eyebrow">Nach deiner Bewerbung</p>
        <h2 id="a-title" class="h2">So geht es weiter.</h2>
        <p class="lead muted">Vier Schritte, vom Absenden bis zum ersten Tag.</p>
        <Button href="#bewerben" variant="primary">Jetzt starten</Button>
      </div>
      <ol class="steps">
        {ablauf.map((a, i) => (
          <li class="schritt"><span class="num">{i + 1}</span><div><h3>{a.t}</h3><p class="muted"><Txt t={a.x} /></p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="faq" aria-labelledby="q-title">
    <div class="wrap fgrid">
      <div class="shead rv">
        <p class="eyebrow">Fragen</p>
        <h2 id="q-title" class="h2">Gut zu wissen.</h2>
        <Button href="#bewerben" variant="outline">Direkt bewerben</Button>
      </div>
      <div>
        {fragen.map((f, i) => (
          <details name="kfaq" open={i === 0}>
            <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
            <div class="ans"><p class="muted"><Txt t={f.a} /></p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="bewerben" class="funnel-sec fullh bgs" style={bg.bewerben} aria-labelledby="f-title">
    <div class="wrap">
      <div class="shead rv">
        <p class="eyebrow">Bewerbung</p>
        <h2 id="f-title" class="h2">In vier Schritten zu uns.</h2>
        <p class="lead muted">Beantworte vier kurze Fragen und hinterlasse deine Nummer. Den Rest klären wir im Gespräch.</p>
      </div>

      <form class="funnel" data-funnel novalidate>
        <div class="prog" aria-hidden="true"><span data-bar></span></div>
        <p class="step" data-stepinfo aria-live="polite">Schritt 1 von 5</p>

        <fieldset data-step>
          <legend>Wo möchtest du arbeiten?</legend>
          <div class="opts">
            {standorte.map((s) => (
              <label class="opt"><input type="radio" name="standort" value={s.name} required /><span><b>{s.name}</b><small>{s.strasse}</small></span></label>
            ))}
            <label class="opt"><input type="radio" name="standort" value="Egal" /><span><b>Egal, mehrere</b><small>Wir suchen den besten Standort für dich</small></span></label>
          </div>
        </fieldset>

        <fieldset data-step>
          <legend>Was passt zu dir?</legend>
          <div class="opts">
            {bereiche.map((b) => (
              <label class="opt"><input type="radio" name="bereich" value={b.name} data-id={b.id} required /><span><b>{b.name}</b><small>{b.text}</small></span></label>
            ))}
          </div>
        </fieldset>

        <fieldset data-step>
          <legend>Wie viel Erfahrung hast du?</legend>
          <div class="opts three">
            {erfahrung.map((e) => (
              <label class="opt"><input type="radio" name="erfahrung" value={e.t} required /><span><b>{e.t}</b><small>{e.x}</small></span></label>
            ))}
          </div>
        </fieldset>

        <fieldset data-step>
          <legend>Ab wann kannst du starten?</legend>
          <div class="opts three">
            {eintritt.map((e) => (
              <label class="opt"><input type="radio" name="eintritt" value={e.t} required /><span><b>{e.t}</b><small>{e.x}</small></span></label>
            ))}
          </div>
        </fieldset>

        <fieldset data-step>
          <legend>Wie erreichen wir dich?</legend>
          <div class="fields">
            <label>Vorname<input name="name" autocomplete="given-name" required /></label>
            <label>Telefon oder WhatsApp<input name="telefon" type="tel" autocomplete="tel" inputmode="tel" required /></label>
            <label>E-Mail <small>(optional)</small><input name="mail" type="email" autocomplete="email" /></label>
          </div>
          <label class="check"><input type="checkbox" name="datenschutz" required /><span>Ich habe den <a href="/datenschutz/">Datenschutzhinweis für Bewerber</a> gelesen <span class="fehlt">[[FEHLT: Text]]</span>.</span></label>
          <p class="err" data-err role="alert" hidden></p>
        </fieldset>

        <div class="nav">
          <button type="button" class="back" data-back hidden>Zurück</button>
          <button type="button" class="next" data-next hidden>Weiter</button>
          <button type="submit" class="send" data-send hidden>Bewerbung abschicken</button>
        </div>

        <div class="done" data-done hidden tabindex="-1">
          <h3 class="display">Geschafft.</h3>
          <p data-summary></p>
          <p class="proto"><span class="fehlt">Prototyp: Die Bewerbung wird noch nicht übertragen.</span> Zum Livegang geht sie per Mail an den gewählten Standort.</p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  // Kennzahlen zählen beim Laden hoch
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el, k) => {
      const ziel = Number(el.dataset.count);
      if (!ziel) return;
      const t0 = performance.now() + 350 + k * 150;
      const lauf = (t: number) => {
        const p = Math.max(0, Math.min(1, (t - t0) / 1100));
        el.textContent = String(Math.round(ziel * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(lauf);
      };
      el.textContent = '0';
      requestAnimationFrame(lauf);
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-funnel]');
  if (form) {
    const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const bar = form.querySelector<HTMLElement>('[data-bar]')!;
    const info = form.querySelector<HTMLElement>('[data-stepinfo]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-send]')!;
    const err = form.querySelector<HTMLElement>('[data-err]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    let i = 0;
    form.classList.add('js');

    const gueltig = (n: number) => {
      const felder = [...steps[n].querySelectorAll<HTMLInputElement>('input')];
      return felder.every((f) => (f.type === 'radio' ? !!form.querySelector(`input[name="${f.name}"]:checked`) : !f.required || (f.type === 'checkbox' ? f.checked : f.value.trim() !== '')));
    };
    const zeige = (n: number, fokus = true) => {
      i = Math.max(0, Math.min(steps.length - 1, n));
      steps.forEach((s, k) => (s.hidden = k !== i));
      bar.style.inlineSize = `${((i + 1) / steps.length) * 100}%`;
      info.textContent = `Schritt ${i + 1} von ${steps.length}`;
      back.hidden = i === 0;
      const letzte = i === steps.length - 1;
      send.hidden = !letzte;
      next.hidden = letzte || !(steps[i].querySelector('input[type=radio]') && gueltig(i));
      err.hidden = true;
      if (fokus) (steps[i].querySelector('input') as HTMLElement | null)?.focus({ preventScroll: true });
    };

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type === 'radio' && i < steps.length - 1) setTimeout(() => zeige(i + 1), 220);
    });
    next.addEventListener('click', () => gueltig(i) && zeige(i + 1));
    back.addEventListener('click', () => zeige(i - 1));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!gueltig(i)) { err.textContent = 'Bitte trage Vorname und Telefon ein und bestätige den Datenschutzhinweis.'; err.hidden = false; return; }
      const d = new FormData(form);
      form.querySelectorAll<HTMLElement>('[data-step], .nav, .prog, .step').forEach((n) => (n.hidden = true));
      form.querySelector<HTMLElement>('[data-summary]')!.textContent = `Danke, ${d.get('name')}. Deine Anfrage: ${d.get('bereich')} in ${d.get('standort') === 'Egal' ? 'einem unserer Standorte' : d.get('standort')}, Erfahrung ${String(d.get('erfahrung')).toLowerCase()}, Start ${String(d.get('eintritt')).toLowerCase()}.`;
      done.hidden = false;
      done.focus();
    });

    // Stellen springen mit vorgewähltem Bereich in den Funnel
    document.querySelectorAll<HTMLElement>('[data-bereich]').forEach((a) =>
      a.addEventListener('click', () => {
        const r = form.querySelector<HTMLInputElement>(`input[data-id="${a.dataset.bereich}"]`);
        if (r) { r.checked = true; }
        const offen = steps.findIndex((_, n) => !gueltig(n));
        zeige(offen === -1 ? steps.length - 1 : offen, false);
      }),
    );
    zeige(0, false);
  }
</script>
<style>
  /* Bildgrund mit flacher Abdunklung, kein Verlauf. Auf großen Bildschirmen steht das Bild fest, der Inhalt läuft darüber. */
  .bgs { position: relative; isolation: isolate; background: var(--black) var(--bg) center / cover no-repeat; }
  .bgs::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(3 5 4 / 0.8); }
  @media (min-width: 62rem) and (prefers-reduced-motion: no-preference) { .bgs { background-attachment: fixed; } }
  .sec { padding-block: var(--space-section); }
  .dark { background: #0a0d0c; }

  /* Lesefortschritt oben */
  .fortschritt { position: fixed; inset: 0 0 auto 0; z-index: 60; block-size: 3px; background: var(--coral-soft); transform-origin: left; scale: 0 1; pointer-events: none; display: none; }

  /* Glas */
  .glass { background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.16); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16), 0 24px 48px -28px rgb(0 0 0 / 0.7); -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .glass { background: rgb(17 22 26 / 0.88); } }

  /* Einblenden beim Scrollen. Ohne Unterstützung oder bei reduzierter Bewegung steht alles sofort da. */
  @keyframes rv-in { from { opacity: 0; translate: 0 2.5rem; } to { opacity: 1; translate: 0 0; } }
  @keyframes fill { from { scale: 1 0; } to { scale: 1 1; } }
  @keyframes aktiv { from { background: #fff; color: var(--ink-muted); border-color: rgb(17 21 19 / 0.25); } to { background: var(--brand-red); color: #fff; border-color: var(--brand-red); } }
  @keyframes prog { to { scale: 1 1; } }
  @keyframes hin { from { opacity: 0; translate: 0 1.75rem; } to { opacity: 1; translate: 0 0; } }
  @keyframes rein { from { opacity: 0; translate: 3rem 0; } to { opacity: 1; translate: 0 0; } }
  @keyframes schweben { 0%, 100% { translate: 0 0; } 50% { translate: 0 -0.35rem; } }
  @keyframes zoom { from { scale: 1.18; } to { scale: 1; } }
  @media (prefers-reduced-motion: no-preference) {
    /* Auftritt beim Laden */
    .copy > * { animation: hin 0.9s var(--ease) both; }
    .copy > :nth-child(2) { animation-delay: 0.1s; }
    .copy > :nth-child(3) { animation-delay: 0.25s; }
    .copy > :nth-child(4) { animation-delay: 0.4s; }
    .facts li { animation: rein 1s var(--ease) both; }
    .facts li:nth-child(2) { animation-delay: 0.15s; }
    .facts li:nth-child(3) { animation-delay: 0.3s; }
    .facts li:hover { animation: none; }
    @supports (animation-timeline: scroll()) {
      .fortschritt { display: block; animation: prog linear both; }
      .fortschritt { animation-timeline: scroll(root); }
    }
    @supports (animation-timeline: view()) {
      .rv { animation: rv-in linear both; }
      .rv { animation-timeline: view(); animation-range: entry 0% entry 55%; }
      .schritt:not(:last-child)::after { animation: fill linear both; }
      .schritt:not(:last-child)::after { animation-timeline: view(); animation-range: cover 28% cover 62%; }
      .schritt .num { animation: aktiv linear both; }
      .schritt .num { animation-timeline: view(); animation-range: entry 45% entry 90%; }
      .tile img { animation: zoom linear both; }
      .tile img { animation-timeline: view(); animation-range: entry 0% cover 55%; }
    }
  }

  /* Held */
  .hero { min-block-size: 100svh; display: grid; align-items: center; padding-block: 8rem 5rem; overflow: clip; }
  .hvideo { position: absolute; inset: 0; z-index: -2; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .vhint { position: absolute; inset: auto var(--gutter) 1.5rem auto; font-size: 0.8125rem; }
  .hgrid { display: grid; gap: 2.5rem; align-items: center; }
  .copy { container-type: inline-size; display: grid; gap: 1.4rem; max-inline-size: 42rem; }
  .big { font-size: clamp(2rem, 11cqw, 4.75rem); line-height: 0.98; }
  .big span { display: block; white-space: nowrap; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .facts { display: grid; gap: 0.75rem; }
  .facts li { transition: translate 0.35s var(--ease), border-color 0.3s var(--ease), background-color 0.3s var(--ease); }
  .facts li:hover { translate: -0.5rem 0; border-color: rgb(255 143 134 / 0.55); background: rgb(255 255 255 / 0.11); }
  .facts li { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 0 1.25rem; padding: 1.1rem 1.5rem; border-radius: var(--r4); }
