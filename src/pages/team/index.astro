---
import Team from '../../layouts/Team.astro';
import { getDb } from '../../lib/server/db';

export const prerender = false;

// Dashboard für die Mitarbeiter. Ohne Sitzung zeigt die Seite nur die Anmeldung (oder die Ersteinrichtung).
const nutzer = Astro.locals.nutzer;
let modus: 'login' | 'setup' | 'app' | 'fehler' = nutzer ? 'app' : 'login';
if (!nutzer) {
  try {
    const db = await getDb();
    const n = await db.prepare('SELECT COUNT(*) AS n FROM benutzer').first<{ n: number }>();
    if (!n || n.n === 0) modus = 'setup';
  } catch (e) {
    console.error(e);
    modus = 'fehler';
  }
}
---
<Team title={modus === 'app' ? 'Dashboard' : modus === 'setup' ? 'Ersteinrichtung' : 'Anmeldung'} modus={modus}>
  {modus === 'fehler' && (
    <main class="auth">
      <div class="karte">
        <h1>Datenbank nicht erreichbar</h1>
        <p>Das Backend braucht die D1 Datenbank (Binding <code>DB</code>). Siehe <code>docs/backend.md</code>.</p>
      </div>
    </main>
  )}

  {(modus === 'login' || modus === 'setup') && (
    <main class="auth">
      <form class="karte" data-auth novalidate>
        <img class="logo" src="/images/logo.svg" alt="Yumini" width="180" height="60" />
        <h1>{modus === 'setup' ? 'Ersteinrichtung' : 'Team Anmeldung'}</h1>
        {modus === 'setup' && <p class="hinweis">Es gibt noch keinen Benutzer. Legen Sie das Konto für die Leitung (Admin) an. Weitere Benutzer legen Sie danach im Dashboard an.</p>}
        {modus === 'setup' && (
          <label>Name<input name="name" autocomplete="name" placeholder="Vor- und Nachname" /></label>
        )}
        <label>Benutzername<input name="benutzername" autocomplete="username" autocapitalize="none" required /></label>
        <label>Passwort<input name="passwort" type="password" autocomplete={modus === 'setup' ? 'new-password' : 'current-password'} required /></label>
        {modus === 'setup' && <p class="klein">Mindestens 10 Zeichen.</p>}
        <p class="fehler" data-fehler role="alert" hidden></p>
        <button class="knopf primaer" type="submit">{modus === 'setup' ? 'Konto anlegen' : 'Anmelden'}</button>
      </form>
    </main>
  )}

  {modus === 'app' && (
    <div class="app" data-app>
      <header class="kopf">
        <img class="logo" src="/images/logo.svg" alt="Yumini" width="120" height="40" />
        <span class="ort">
          <label class="sr" for="ort">Standort</label>
          <select id="ort" data-ort></select>
        </span>
        <nav class="tabs" data-tabs aria-label="Bereiche"></nav>
        <span class="user">
          <button class="knopf leise" data-konto type="button"><span data-username></span></button>
        </span>
      </header>
      <main class="inhalt" data-inhalt id="main" tabindex="-1"><p class="laden">Lade …</p></main>
      <div class="toasts" data-toasts aria-live="polite"></div>
      <dialog data-dialog></dialog>
    </div>
  )}

  {modus !== 'fehler' && <script>import '../../scripts/team';</script>}
</Team>
