{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss exakt dem Namen des Projekts in Cloudflare (Workers & Pages) entsprechen.
  "name": "yumini-sushi",
  // main und assets setzt der Astro Adapter beim Build (dist/server/wrangler.json)
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Bindings: ohne "id" legt Wrangler den KV Namespace beim ersten Deploy selbst an.
  "kv_namespaces": [
    { "binding": "CACHE" }
  ],

  // Reservierungen, Benutzer, Tische. Ohne database_id legt Wrangler die Datenbank beim ersten Deploy selbst an,
  // das Schema legt das Backend beim ersten Zugriff an (src/lib/server/db.ts, migrations/0001_init.sql).
  "d1_databases": [
    { "binding": "DB", "database_name": "yumini-reservierung", "migrations_dir": "migrations" }
  ],

  // Öffentliche Variablen (nicht geheim). Place IDs der Google Unternehmensprofile hier eintragen.
  // Geheimes (GOOGLE_PLACES_KEY, TURNSTILE_SECRET, RESEND_API_KEY) kommt NICHT hierhin, siehe docs/cloudflare.md.
  "vars": {
    "PLACE_ID_BOCHUM": "",
    "PLACE_ID_DORTMUND": "",
    "PLACE_ID_GELSENKIRCHEN": "",
    "PLACE_ID_LUEDENSCHEID": "",
    "PLACE_ID_SIEGEN": "",
    "TURNSTILE_SITE_KEY": "",
    // "true" erlaubt im Backend Testdaten anlegen und Reservierungen leeren. Zum Livegang auf "false" setzen.
    "TESTPHASE": "true"
  }
}
